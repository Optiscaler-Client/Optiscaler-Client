<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <x:String x:Key="TxtSettingsTitle">设置</x:String>
    <x:String x:Key="TxtGamepadConnected">手柄已连接</x:String>
    <x:String x:Key="TxtGamepadDisconnected">手柄已断开</x:String>
    <x:String x:Key="TxtSettingsDesc">管理应用程序首选项</x:String>
    <x:String x:Key="TxtAppPrefs">应用首选项</x:String>
    <x:String x:Key="TxtCacheMgmt">本地缓存 &amp; 默认版本管理</x:String>
    <x:String x:Key="TxtCacheDesc">查看并管理已下载的组件版本，设置快速安装和游戏管理的默认版本，以及释放本地存储空间</x:String>
    <x:String x:Key="TxtManage">&#xE8B7;  管理</x:String>
    <x:String x:Key="TxtLanguage">应用程序语言</x:String>
    <x:String x:Key="TxtLanguageDesc">更改用户界面语言</x:String>
    <x:String x:Key="TxtClose">关闭</x:String>
    <x:String x:Key="TxtGotIt">确定</x:String>
    <x:String x:Key="TxtAppRepoTitle">应用仓库</x:String>
    <x:String x:Key="TxtAppRepoDesc">用于更新和反馈的目标 GitHub 仓库（所有者/仓库名）。</x:String>
    <!-- Guide Window -->
    <x:String x:Key="TxtGuideTitle">指南</x:String>
    <x:String x:Key="TxtGuideHeader">如何使用 Optiscaler Client</x:String>
    <x:String x:Key="TxtGuideHeaderDesc">增强游戏的简单步骤</x:String>
    <x:String x:Key="TxtGuideStep1Title">1. 找到游戏</x:String>
    <x:String x:Key="TxtGuideStep1Desc">点击「扫描游戏」按钮，让应用程序从 Steam、Epic、GOG 或 Xbox 自动查找已安装游戏。如果有其它游戏，请使用「手动添加」</x:String>
    <x:String x:Key="TxtGuideStep2Title">2. 管理游戏</x:String>
    <x:String x:Key="TxtGuideStep2Desc">在列表中游戏右侧，点击「管理」，将打开管理窗口，允许为该特定游戏安装或更新 OptiScaler</x:String>
    <x:String x:Key="TxtGuideStep3Title">3. 安装 OptiScaler</x:String>
    <x:String x:Key="TxtGuideStep3Desc">在管理窗口内，选择 OptiScaler 版本和选项，使用「自动安装」进行快速设置；如果自动安装失败或无法找到正确的可执行文件（.exe），请使用「手动安装」选择游戏的可执行文件。</x:String>
    <x:String x:Key="TxtGuideStep4Title">4. 游玩</x:String>
    <x:String x:Key="TxtGuideStep4Desc">安装后，正常启动游戏，在游戏内，使用「Insert」键打开 OptiScaler 菜单面板来调整设置！</x:String>

    <!-- MainWindow -->
    <x:String x:Key="TxtAppTitle">Optiscaler Client</x:String>
    <x:String x:Key="TxtBtnScan">⟳  扫描游戏</x:String>
    <x:String x:Key="TxtBtnAddManual">＋  手动添加</x:String>
    <x:String x:Key="TxtTipSettings">设置</x:String>
    <x:String x:Key="TxtTipComponent">组件版本</x:String>
    <x:String x:Key="TxtUpdateNukem">↑  更新 NukemFG</x:String>
    <x:String x:Key="TxtTipUpdateNukem">新的 NukemFG 版本可用，点击选择更新的 DLL。</x:String>
    <x:String x:Key="TxtDefaultGpu">检测 GPU 中…</x:String>
    <x:String x:Key="TxtManageGame">管理</x:String>
    <x:String x:Key="TxtQuickInstall">✦ 快速安装</x:String>
    <x:String x:Key="TxtQuickUninstall">🗑️ 快速卸载</x:String>
    <x:String x:Key="TxtInitialScanTitle">首次扫描</x:String>
    <x:String x:Key="TxtInitialScanDesc">在扫描驱动器寻找游戏之前，请选择要扫描的驱动器和来源。可以关闭此窗口，稍后再扫描。</x:String>
    <x:String x:Key="TxtScanSetupTitle">扫描设置</x:String>
    <x:String x:Key="TxtScanSetupDesc">选择要扫描的驱动器和来源。可以关闭此窗口，稍后再扫描。</x:String>
    <x:String x:Key="TxtInitialScanDrives">要扫描的驱动器</x:String>
    <x:String x:Key="TxtInitialScanSources">要扫描的来源</x:String>
    <x:String x:Key="TxtInitialScanStart">开始扫描</x:String>
    <x:String x:Key="TxtInitialScanClose">关闭</x:String>
    <x:String x:Key="TxtInitialScanNoDrives">未检测到驱动器</x:String>
    <x:String x:Key="TxtScanningTitle">扫描游戏中...</x:String>
    <x:String x:Key="TxtScanningDesc">在所有平台上查找游戏...</x:String>
    <x:String x:Key="TxtSearchGames">搜索游戏...</x:String>
    <x:String x:Key="TxtRemoveGameTip">删除手动添加的游戏</x:String>
    <x:String x:Key="TxtRemoveGameTitle">删除游戏</x:String>
    <x:String x:Key="TxtRemoveGameConfirm">确定要从列表中删除 '{0}' 吗？</x:String>
    <x:String x:Key="TxtLinuxSteamOnlyNotice">在 Linux 上运行：仅 Steam 游戏会被自动检测到，其他平台不受支持。</x:String>

    <!-- ManageCacheWindow -->
    <x:String x:Key="TxtManageCacheTitle">管理本地版本</x:String>
    <x:String x:Key="TxtLocalVersions">本地版本</x:String>
    <x:String x:Key="TxtManageCacheDesc">管理已下载的 OptiScaler 缓存</x:String>
    <x:String x:Key="TxtDownloadedVersions">已下载的 OptiScaler 版本：</x:String>
    <x:String x:Key="TxtDeleteIcon">🗑️ 删除</x:String>
    <x:String x:Key="TxtNoVersions">当前没有下载的版本</x:String>
    <x:String x:Key="TxtToastSuccess">成功</x:String>
    <x:String x:Key="TxtConfirmDelTitle">确认删除</x:String>
    <x:String x:Key="TxtCustomVersions">自定义 OptiScaler 版本</x:String>
    <x:String x:Key="TxtImportArchive">导入归档</x:String>
    <x:String x:Key="TxtNoCustomVersions">尚未导入自定义版本</x:String>
    <x:String x:Key="TxtCustomVersionWarning">⚠ 请将自定义 OptiScaler 构建导入为 7z、zip 或 rar 归档文件。如果归档包含应用无法跟踪的文件，安装/卸载可能失败。请仅包含 OptiScaler 发布文件。</x:String>
    <x:String x:Key="TxtImporting">正在导入...</x:String>
    <x:String x:Key="TxtConfirmDelMsg">确定要删除此版本吗？</x:String>
    <x:String x:Key="TxtCancel">取消</x:String>
    <x:String x:Key="TxtDeletePlain">删除</x:String>
    <x:String x:Key="TxtConfirmDelFormat">确定要从本地存储中删除 OptiScaler v{0} 吗？</x:String>
    <x:String x:Key="TxtDeletedSuccessFormat">OptiScaler v{0} 删除成功</x:String>
    <x:String x:Key="TxtFailedDeleteFormat">删除版本失败：{0}</x:String>
