    <x:String x:Key="TxtHelpPageSettings">设置 &amp; 配置</x:String>
    <x:String x:Key="TxtHelpPageBulkOperations">批量操作</x:String>
    <x:String x:Key="TxtHelpPageGamepad">手柄支持</x:String>
