    <!-- ManageGameWindow: Recommended Config sidebar (Compatibility List) -->
    <x:String x:Key="TxtCompatSidebarTitle">Önerilen Yapılandırma</x:String>
    <x:String x:Key="TxtCompatSidebarCollapse">Kenar çubuğunu daralt</x:String>
