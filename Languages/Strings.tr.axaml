    <x:String x:Key="TxtProfSearchResultFormat">{1} icinde {0} sonuc.</x:String>
    <x:String x:Key="TxtProfNotFound">Profil bulunamadi.</x:String>
    <x:String x:Key="TxtProfSearchNotFound">Eslesen profil bulunamadi.</x:String>

    <!-- Profile Editor View -->
    <x:String x:Key="TxtEditorBackBtn">← Profiller</x:String>
    <x:String x:Key="TxtEditorTitle">Profil Duzenleyici</x:String>
    <x:String x:Key="TxtEditorDesc">Bu profil icin OptiScaler ayarlarini yapilandirin</x:String>
    <x:String x:Key="TxtEditorNewTitle">Yeni profil</x:String>
    <x:String x:Key="TxtEditorEditTitleFmt">Duzenle: {0}</x:String>
    <x:String x:Key="TxtEditorNameLabel">Profil adi</x:String>
    <x:String x:Key="TxtEditorNameWatermark">Profil adini girin</x:String>
    <x:String x:Key="TxtEditorDescLabel">Aciklama</x:String>
    <x:String x:Key="TxtEditorDescWatermark">Aciklama girin (isteğe bagli)</x:String>
    <x:String x:Key="TxtEditorModeLabel">Mod</x:String>
    <x:String x:Key="TxtEditorModeEasy">Kolay</x:String>
    <x:String x:Key="TxtEditorModeAdvanced">Gelismis</x:String>
    <x:String x:Key="TxtEditorNavLabel">Navigasyon</x:String>
    <x:String x:Key="TxtEditorSearchWm">Ayar ara...</x:String>
