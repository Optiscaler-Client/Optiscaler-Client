    <x:String x:Key="TxtUpdateError">Erro na atualização</x:String>
    <x:String x:Key="TxtNoUpdateFound">O aplicativo já está atualizado.</x:String>
    <x:String x:Key="TxtUpdateCheckError">Houve um problema ao verificar atualizações. Tente novamente mais tarde.</x:String>

