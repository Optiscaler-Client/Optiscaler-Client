    <x:String x:Key="TxtDownloadErrorPrefix">Falha ao baixar o OptiScaler: {0}</x:String>
    <x:String x:Key="TxtOptiUninstallSuccess">OptiScaler desinstalado com sucesso.</x:String>

    <x:String x:Key="TxtOptiUninstallResidueTitle">OptiScaler desinstalado</x:String>

    <x:String x:Key="TxtOptiUninstallResidueMsg">O OptiScaler foi desinstalado, mas {0} arquivo(s) que podem pertencer ao jogo foram mantidos por precaução:&#x0a;&#x0a;{1}&#x0a;&#x0a;Se você tem certeza de que o jogo não os incluía, use "Limpeza de pasta" para removê-los.</x:String>
    <x:String x:Key="TxtOptiUninstallFail">Falha na desinstalação: {0}</x:String>

