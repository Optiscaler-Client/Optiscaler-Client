<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    
    <x:String x:Key="TxtSettingsTitle">Configurações</x:String>
    <x:String x:Key="TxtGamepadConnected">Controle conectado</x:String>
    <x:String x:Key="TxtGamepadDisconnected">Controle desconectado</x:String>
