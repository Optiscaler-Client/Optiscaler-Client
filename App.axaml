<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="OptiscalerClient.App"
             RequestedThemeVariant="Dark">
    <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://OptiscalerClient/Languages/Strings.en.axaml" />
                <ResourceInclude Source="avares://OptiscalerClient/Styles/Icons.axaml" />
            </ResourceDictionary.MergedDictionaries>

            <Color x:Key="BgDeepColor">#0E0E1A</Color>
            <Color x:Key="BgBaseColor">#13131F</Color>
            <Color x:Key="BgSurfaceColor">#1C1C2E</Color>
            <Color x:Key="BgCardColor">#1E1E30</Color>
            <Color x:Key="BgElevatedColor">#252540</Color>
            <Color x:Key="BorderSubtleColor">#2A2A42</Color>
            <Color x:Key="BorderDefaultColor">#363660</Color>
            <Color x:Key="AccentPrimaryColor">#8B73F8</Color>
            <Color x:Key="AccentPrimaryHoverColor">#9D88FF</Color>
            <Color x:Key="AccentPrimaryPressedColor">#7560E0</Color>
            <Color x:Key="AccentWarmColor">#F0834A</Color>
            <Color x:Key="AccentWarmHoverColor">#F59560</Color>
            <Color x:Key="TextPrimaryColor">#E4E4EF</Color>
            <Color x:Key="TextSecondaryColor">#8A8AAA</Color>
            <Color x:Key="TextDisabledColor">#4A4A65</Color>
            <Color x:Key="StatusSuccessColor">#5CB87E</Color>
            <Color x:Key="StatusErrorColor">#E06060</Color>
            <Color x:Key="StatusWarningColor">#D4A04A</Color>
            <!-- Deliberately desaturated/pastel, unlike the vivid AccentPrimaryColor — used to mark
                 experimental UI (see the RenoDX "Experimental" zone in ManageGameWindow) without it
                 competing visually with real actions/warnings. -->
            <Color x:Key="ExperimentalColor">#8983A6</Color>

            <SolidColorBrush x:Key="BrBgDeep"     Color="{StaticResource BgDeepColor}"/>
            <SolidColorBrush x:Key="BrBgBase"     Color="{StaticResource BgBaseColor}"/>
            <SolidColorBrush x:Key="BrBgSurface"  Color="{StaticResource BgSurfaceColor}"/>
            <SolidColorBrush x:Key="BrBgCard"     Color="{StaticResource BgCardColor}"/>
            <SolidColorBrush x:Key="BrBgElevated" Color="{StaticResource BgElevatedColor}"/>
            <SolidColorBrush x:Key="BrBorderSubtle"  Color="{StaticResource BorderSubtleColor}"/>
            <SolidColorBrush x:Key="BrBorderDefault" Color="{StaticResource BorderDefaultColor}"/>
            <SolidColorBrush x:Key="BrAccent"          Color="{StaticResource AccentPrimaryColor}"/>
            <SolidColorBrush x:Key="BrAccentHover"     Color="{StaticResource AccentPrimaryHoverColor}"/>
            <SolidColorBrush x:Key="BrAccentPressed"   Color="{StaticResource AccentPrimaryPressedColor}"/>
            <SolidColorBrush x:Key="BrAccentWarm"      Color="{StaticResource AccentWarmColor}"/>
            <SolidColorBrush x:Key="BrAccentWarmHover" Color="{StaticResource AccentWarmHoverColor}"/>
            <SolidColorBrush x:Key="BrTextPrimary"   Color="{StaticResource TextPrimaryColor}"/>
            <SolidColorBrush x:Key="BrTextSecondary" Color="{StaticResource TextSecondaryColor}"/>
            <SolidColorBrush x:Key="BrTextDisabled"  Color="{StaticResource TextDisabledColor}"/>
            <SolidColorBrush x:Key="BrSuccess" Color="{StaticResource StatusSuccessColor}"/>
            <SolidColorBrush x:Key="BrError"   Color="{StaticResource StatusErrorColor}"/>
            <SolidColorBrush x:Key="BrWarning" Color="{StaticResource StatusWarningColor}"/>
            <SolidColorBrush x:Key="BrExperimental" Color="{StaticResource ExperimentalColor}"/>

            <!-- Modern Design System & Ambient Tokens -->
            <SolidColorBrush x:Key="BrHover"        Color="#0DFFFFFF"/>
            <SolidColorBrush x:Key="BrAccentSoft"   Color="#248B73F8"/>
            <SolidColorBrush x:Key="BrSuccessSoft"  Color="#245CB87E"/>
            <SolidColorBrush x:Key="BrErrorSoft"    Color="#24E06060"/>
            <SolidColorBrush x:Key="BrWarningSoft"  Color="#24D4A04A"/>

            <RadialGradientBrush x:Key="BrAmbientGlow" Center="95%,0%" GradientOrigin="95%,0%" RadiusX="70%" RadiusY="70%">
                <GradientStop Color="#208B73F8" Offset="0"/>
                <GradientStop Color="#008B73F8" Offset="1"/>
            </RadialGradientBrush>
            <LinearGradientBrush x:Key="BrHeroGradient" StartPoint="0%,0%" EndPoint="100%,100%">
                <GradientStop Color="#308B73F8" Offset="0"/>
                <GradientStop Color="#001E1E30" Offset="0.75"/>
            </LinearGradientBrush>

            <FontFamily x:Key="FontPrimary">Segoe UI Variable, Segoe UI, sans-serif</FontFamily>
            <FontFamily x:Key="FontIcons">avares://OptiscalerClient/assets/FluentSystemIcons-Regular.ttf#FluentSystemIcons-Regular, Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
            <FontFamily x:Key="FontIconsFilled">avares://OptiscalerClient/assets/FluentSystemIcons-Filled.ttf#FluentSystemIcons-Filled</FontFamily>
            <x:Double x:Key="FontSizeCaption">11</x:Double>
            <x:Double x:Key="FontSizeBody">13</x:Double>
            <x:Double x:Key="FontSizeBodyLarge">15</x:Double>
            <x:Double x:Key="FontSizeSubtitle">18</x:Double>
            <x:Double x:Key="FontSizeTitle">22</x:Double>

            <CornerRadius x:Key="RadiusSmall">4</CornerRadius>
            <CornerRadius x:Key="RadiusMedium">8</CornerRadius>
            <CornerRadius x:Key="RadiusLarge">12</CornerRadius>
            <CornerRadius x:Key="RadiusXL">16</CornerRadius>
            <CornerRadius x:Key="RadiusPill">50</CornerRadius>

            <!-- Override FluentTheme default Resource Dictionary keys for ComboBox -->
            <SolidColorBrush x:Key="ComboBoxBackground" Color="{StaticResource BgSurfaceColor}" />
            <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="{StaticResource BgSurfaceColor}" />
            <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="{StaticResource BgElevatedColor}" />
            <SolidColorBrush x:Key="ComboBoxBackgroundDisabled" Color="{StaticResource BgBaseColor}" />
            <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="{StaticResource BorderSubtleColor}" />
            <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="{StaticResource AccentPrimaryColor}" />
            <SolidColorBrush x:Key="ComboBoxBorderBrushPressed" Color="{StaticResource AccentPrimaryPressedColor}" />
            <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="{StaticResource BgCardColor}" />
            <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="{StaticResource BorderDefaultColor}" />
            <SolidColorBrush x:Key="ComboBoxItemBackgroundSelected" Color="{StaticResource AccentPrimaryColor}" />
            <SolidColorBrush x:Key="ComboBoxItemBackgroundPointerOver" Color="{StaticResource BgElevatedColor}" />
            <!-- End overrides -->
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <!-- Base Button -->
        <Style Selector="Button">
            <Setter Property="FontFamily"    Value="{StaticResource FontPrimary}"/>
            <Setter Property="FontSize"      Value="{StaticResource FontSizeBody}"/>
            <Setter Property="FontWeight"    Value="SemiBold"/>
            <Setter Property="Foreground"    Value="{StaticResource BrTextPrimary}"/>
            <Setter Property="Background"    Value="{StaticResource BrBgElevated}"/>
            <Setter Property="BorderBrush"   Value="{StaticResource BrBorderDefault}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"       Value="16,8"/>
            <Setter Property="Cursor"        Value="Hand"/>
            <Setter Property="CornerRadius"  Value="{StaticResource RadiusMedium}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource BrBgElevated}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrAccent}"/>
            <Setter Property="Foreground" Value="{StaticResource BrTextPrimary}"/>
        </Style>
        <Style Selector="Button:pressed /template/ ContentPresenter">
            <Setter Property="Opacity" Value="0.8"/>
        </Style>
        <Style Selector="Button:disabled /template/ ContentPresenter">
            <Setter Property="Opacity" Value="0.4"/>
        </Style>

        <!-- Base Button (Class) for explicit styles -->
        <Style Selector="Button.BtnBase" />
        <Style Selector="Button.BtnBase:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource BrBgElevated}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrAccent}"/>
        </Style>

        <!-- Primary button — violet accent -->
        <Style Selector="Button.BtnPrimary">
            <Setter Property="Background"   Value="{StaticResource BrAccent}"/>
            <Setter Property="BorderBrush"  Value="{StaticResource BrAccent}"/>
            <Setter Property="Foreground"   Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="Button.BtnPrimary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource BrAccentHover}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrAccentHover}"/>
        </Style>
        <Style Selector="Button.BtnPrimary:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource BrAccentPressed}"/>
        </Style>

        <!-- Secondary button — subtle surface background with subtle border -->
        <Style Selector="Button.BtnSecondary">
            <Setter Property="Background" Value="{StaticResource BrBgSurface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrBorderSubtle}"/>
            <Setter Property="Foreground" Value="{StaticResource BrTextPrimary}"/>
        </Style>
        <Style Selector="Button.BtnSecondary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource BrBgElevated}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrAccent}"/>
            <Setter Property="Foreground" Value="{StaticResource BrTextPrimary}"/>
        </Style>
        <Style Selector="Button.BtnSecondary:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource BrBgCard}"/>
            <Setter Property="Opacity" Value="0.85"/>
        </Style>

        <!-- Danger button — red -->
        <Style Selector="Button.BtnDanger">
            <Setter Property="Background"  Value="#3D1F1F"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrError}"/>
            <Setter Property="Foreground"  Value="{StaticResource BrError}"/>
        </Style>
        <Style Selector="Button.BtnDanger:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#4D2525"/>
            <Setter Property="Foreground" Value="{StaticResource BrError}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrError}"/>
        </Style>

        <!-- Success button — green -->
        <Style Selector="Button.BtnSuccess">
            <Setter Property="Background"  Value="#1A3D2A"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrSuccess}"/>
            <Setter Property="Foreground"  Value="{StaticResource BrSuccess}"/>
        </Style>
        <Style Selector="Button.BtnSuccess:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#224D34"/>
            <Setter Property="Foreground" Value="{StaticResource BrSuccess}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrSuccess}"/>
        </Style>

        <!-- Warm/Orange button (NukemFG update) -->
        <Style Selector="Button.BtnWarm">
            <Setter Property="Background"  Value="#3D2410"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrAccentWarm}"/>
            <Setter Property="Foreground"  Value="{StaticResource BrAccentWarm}"/>
        </Style>
        <Style Selector="Button.BtnWarm:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#4D2D14"/>
            <Setter Property="Foreground" Value="{StaticResource BrAccentWarm}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrAccentWarm}"/>
        </Style>

        <!-- Success ComboBox — mirrors Button.BtnSuccess: dark-green tinted background, green
             border and foreground. Applied to the install-action dropdowns (CmbInstallAction /
             CmbInstallActionManual) that visually replace the BtnSuccess install buttons when
             multiple actions are available.
             Template part names come from the Avalonia 11 FluentTheme ComboBox ControlTheme:
               · Border#Background       — outer border/background (hover re-paints here)
               · PathIcon#DropDownGlyph  — the chevron arrow
               · Border#PopupBorder      — the open dropdown panel -->
        <Style Selector="ComboBox.BtnSuccess">
            <Setter Property="Background"    Value="#1A3D2A"/>
            <Setter Property="BorderBrush"   Value="{StaticResource BrSuccess}"/>
            <Setter Property="Foreground"    Value="{StaticResource BrSuccess}"/>
            <Setter Property="CornerRadius"  Value="{StaticResource RadiusMedium}"/>
            <Setter Property="FontWeight"    Value="SemiBold"/>
        </Style>
        <!-- Arrow / chevron -->
        <Style Selector="ComboBox.BtnSuccess /template/ PathIcon#DropDownGlyph">
            <Setter Property="Foreground" Value="{StaticResource BrSuccess}"/>
        </Style>
        <!-- Hover: correct template part is Border#Background (no PART_ prefix in Fluent 11) -->
        <Style Selector="ComboBox.BtnSuccess:pointerover /template/ Border#Background">
            <Setter Property="Background"  Value="#224D34"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrSuccess}"/>
        </Style>
        <!-- Open dropdown panel — green-tinted background + green border -->
        <Style Selector="ComboBox.BtnSuccess /template/ Border#PopupBorder">
            <Setter Property="Background"  Value="#152E20"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrSuccess}"/>
        </Style>
        <!-- Placeholder text — same green as the foreground so it reads like the button label -->
        <Style Selector="ComboBox.BtnSuccess /template/ TextBlock#PlaceholderTextBlock">
            <Setter Property="Foreground"   Value="{StaticResource BrSuccess}"/>
            <Setter Property="FontWeight"   Value="SemiBold"/>
            <Setter Property="Opacity"      Value="1"/>
        </Style>
        
        <!-- Textbox overriding Fluent theme -->
        <Style Selector="TextBox">
            <Setter Property="FontFamily"         Value="{StaticResource FontPrimary}"/>
            <Setter Property="FontSize"           Value="{StaticResource FontSizeBody}"/>
            <Setter Property="Foreground"         Value="{StaticResource BrTextPrimary}"/>
            <Setter Property="Background"         Value="{StaticResource BrBgSurface}"/>
            <Setter Property="BorderBrush"        Value="{StaticResource BrBorderSubtle}"/>
            <Setter Property="BorderThickness"    Value="1"/>
            <Setter Property="CornerRadius"       Value="{StaticResource RadiusMedium}"/>
            <Setter Property="Padding"            Value="10,6"/>
            <Setter Property="CaretBrush"         Value="{StaticResource BrAccent}"/>
            <Setter Property="SelectionBrush"     Value="{StaticResource BrAccent}"/>
        </Style>
        <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="{StaticResource BrAccent}"/>
        </Style>
        <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="{StaticResource BrAccent}"/>
        </Style>
        
        <!-- ComboBox and CheckBox -->
        <Style Selector="ComboBox">
            <Setter Property="FontFamily"         Value="{StaticResource FontPrimary}"/>
            <Setter Property="FontSize"           Value="{StaticResource FontSizeBody}"/>
            <Setter Property="Foreground"         Value="{StaticResource BrTextPrimary}"/>
            <Setter Property="CornerRadius"       Value="{StaticResource RadiusMedium}"/>
            <Setter Property="Padding"            Value="12,8"/>
            <Setter Property="MinHeight"          Value="40"/>
            <Setter Property="MaxDropDownHeight"  Value="300"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style Selector="ComboBoxItem">
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <Style Selector="ComboBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- FluentTheme's disabled ComboBox falls back to its own light-grey border/foreground
             resource keys, which we never overrode — clashes against this app's dark card
             backgrounds. Dimming the whole control instead (same trick as Button:disabled) fades
             it uniformly into the surrounding dark chrome rather than flashing grey. -->
        <Style Selector="ComboBox:disabled">
            <Setter Property="Opacity" Value="0.45"/>
        </Style>

        <!-- Marks sentinel/fallback dropdown entries (Default, Game controlled, None, ...) so they
             read as distinct from real choices while the list is open — same rounded-pill
             language as .ActionOption below, but neutral/muted (BgElevated + BorderSubtle, no
             accent color) since these are fallbacks, not actions. Only ComboBoxItem is styled,
             not the closed box — Avalonia's ComboBox shows the selection via its own
             ContentPresenter, so the compact/closed display is unaffected. -->
        <Style Selector="ComboBoxItem.SentinelOption">
            <Setter Property="FontStyle" Value="Italic"/>
            <Setter Property="Background" Value="{StaticResource BrBgElevated}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrBorderSubtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusMedium}"/>
            <Setter Property="Margin" Value="6,4,6,2"/>
        </Style>
        <!-- FluentTheme's ComboBoxItem paints :pointerover directly on its own
             /template/ ContentPresenter (a hardcoded rule inside its ControlTheme), bypassing
             whatever the control's own Background property says — same reason :selected above
             has to target /template/ ContentPresenter too instead of the plain Background
             property. A setter on the bare control (tried first) is silently ignored for this
             pseudo-class specifically. BrBgElevated is also already the lightest neutral
             background token in the palette, so a plain resource swap (e.g. BrBgCard) would be
             darker — invisible/backwards; a translucent white overlay guarantees lighter, always. -->
        <Style Selector="ComboBoxItem.SentinelOption:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#22FFFFFF"/>
        </Style>

        <!-- Marks "add new" / "manage" dropdown entries (+ New Profile, Manage versions…,
             New / Import…) as an action rather than another value to pick — pill-shaped and
             accent-tinted so it reads like a compact button embedded in the list, echoing
             this app's real buttons (RadiusMedium, accent border) instead of an unstyled row. -->
        <Style Selector="ComboBoxItem.ActionOption">
            <Setter Property="Background" Value="#1F8B73F8"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrAccent}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusMedium}"/>
            <Setter Property="Margin" Value="6,4,6,2"/>
        </Style>
        <Style Selector="ComboBoxItem.ActionOption /template/ ContentPresenter">
            <Setter Property="Foreground" Value="{StaticResource BrAccent}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <!-- Stronger tint on hover, not solid — the badge/text stay accent-on-dark instead of
             needing a separate white variant once the row itself goes fully accent-colored.
             Targets /template/ ContentPresenter for the same reason as SentinelOption above. -->
        <Style Selector="ComboBoxItem.ActionOption:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#3D8B73F8"/>
        </Style>

        <Style Selector="CheckBox">
            <Setter Property="FontFamily"         Value="{StaticResource FontPrimary}"/>
            <Setter Property="FontSize"           Value="{StaticResource FontSizeBody}"/>
            <Setter Property="Foreground"         Value="{StaticResource BrTextPrimary}"/>
            <Setter Property="CornerRadius"       Value="{StaticResource RadiusSmall}"/>
        </Style>

        <!-- Flyouts (e.g. the game-list filter dropdown) — match the app's dark theme instead
             of Fluent's default light chrome. -->
        <Style Selector="FlyoutPresenter">
            <Setter Property="Background"      Value="{StaticResource BrBgElevated}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource BrBorderDefault}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="{StaticResource RadiusMedium}"/>
            <Setter Property="Padding"         Value="4"/>
        </Style>

        <Style Selector="ListBox">
            <Setter Property="Background"         Value="Transparent"/>
            <Setter Property="BorderThickness"    Value="0"/>
            <Setter Property="CornerRadius"       Value="{StaticResource RadiusMedium}"/>
        </Style>

        <Style Selector="ListBoxItem">
            <Setter Property="Padding"            Value="12,8"/>
            <Setter Property="CornerRadius"       Value="{StaticResource RadiusSmall}"/>
            <Setter Property="Margin"             Value="0,2"/>
        </Style>

        <!-- Typography: Monospace for paths, versions, and technical metadata -->
        <Style Selector="TextBlock.Mono">
            <Setter Property="FontFamily" Value="Cascadia Code, JetBrains Mono, Consolas, Courier New, monospace"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}"/>
        </Style>

        <!-- ════════════════════════════════════════════════════════
             DESIGN SYSTEM SURFACES & BADGES
             ════════════════════════════════════════════════════════ -->

        <Style Selector="Border.Card">
            <Setter Property="Background" Value="{StaticResource BrBgCard}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrBorderSubtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusLarge}"/>
            <Setter Property="BoxShadow" Value="0 8 24 -6 #50000000"/>
        </Style>
        <Style Selector="Border.Card.Interactive">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.18"/>
                    <BrushTransition Property="Background" Duration="0:0:0.18"/>
                    <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.22"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.Card.Interactive:pointerover">
            <Setter Property="BorderBrush" Value="{StaticResource BrAccent}"/>
            <Setter Property="Background" Value="{StaticResource BrBgElevated}"/>
            <Setter Property="BoxShadow" Value="0 12 28 -6 #70000000, 0 0 12 0 #188B73F8"/>
        </Style>

        <Style Selector="Border.SubCard">
            <Setter Property="Background" Value="{StaticResource BrBgElevated}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrBorderSubtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusMedium}"/>
            <Setter Property="Padding" Value="14,10"/>
        </Style>

        <!-- Callouts (informational banners with 3px accent stroke) -->
        <Style Selector="Border.Callout">
            <Setter Property="Background" Value="#148B73F8"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrAccent}"/>
            <Setter Property="BorderThickness" Value="3,0,0,0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="10,6"/>
        </Style>
        <Style Selector="Border.Callout.Warning">
            <Setter Property="Background" Value="{StaticResource BrWarningSoft}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrWarning}"/>
        </Style>
        <Style Selector="Border.Callout.Danger">
            <Setter Property="Background" Value="{StaticResource BrErrorSoft}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrError}"/>
        </Style>
        <Style Selector="Border.Callout.Success">
            <Setter Property="Background" Value="{StaticResource BrSuccessSoft}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrSuccess}"/>
        </Style>

        <!-- Icon Tile -->
        <Style Selector="Border.IconTile">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Background" Value="{StaticResource BrAccentSoft}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Border.IconTile > PathIcon">
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Foreground" Value="{StaticResource BrAccent}"/>
        </Style>
        <Style Selector="Border.IconTile.Small">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>
        <Style Selector="Border.IconTile.Small > PathIcon">
            <Setter Property="Width" Value="14"/>
            <Setter Property="Height" Value="14"/>
        </Style>
        <Style Selector="Border.IconTile.Large">
            <Setter Property="Width" Value="48"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="CornerRadius" Value="12"/>
        </Style>
        <Style Selector="Border.IconTile.Large > PathIcon">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
        </Style>
        <Style Selector="Border.IconTile.Success">
            <Setter Property="Background" Value="{StaticResource BrSuccessSoft}"/>
        </Style>
        <Style Selector="Border.IconTile.Success > PathIcon">
            <Setter Property="Foreground" Value="{StaticResource BrSuccess}"/>
        </Style>
        <Style Selector="Border.IconTile.Warning">
            <Setter Property="Background" Value="{StaticResource BrWarningSoft}"/>
        </Style>
        <Style Selector="Border.IconTile.Warning > PathIcon">
            <Setter Property="Foreground" Value="{StaticResource BrWarning}"/>
        </Style>
        <Style Selector="Border.IconTile.Danger">
            <Setter Property="Background" Value="{StaticResource BrErrorSoft}"/>
        </Style>
        <Style Selector="Border.IconTile.Danger > PathIcon">
            <Setter Property="Foreground" Value="{StaticResource BrError}"/>
        </Style>

        <!-- Standard PathIcon dimensions -->
        <Style Selector="PathIcon">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
        </Style>
        <Style Selector="Button PathIcon">
            <Setter Property="Width" Value="14"/>
            <Setter Property="Height" Value="14"/>
        </Style>

        <!-- Upscaler & Status Badges -->
        <Style Selector="Border.Badge">
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Border.Badge TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style Selector="Border.Badge.Dlss">
            <Setter Property="Background" Value="#1F5CB87E"/>
            <Setter Property="BorderBrush" Value="#405CB87E"/>
        </Style>
        <Style Selector="Border.Badge.Dlss TextBlock">
            <Setter Property="Foreground" Value="#7FD481"/>
        </Style>
        <Style Selector="Border.Badge.Dlss.Injected">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#405CB87E"/>
        </Style>
        <Style Selector="Border.Badge.Dlss.Injected TextBlock">
            <Setter Property="Foreground" Value="#7FD481"/>
            <Setter Property="Opacity" Value="0.75"/>
        </Style>

        <Style Selector="Border.Badge.Fsr">
            <Setter Property="Background" Value="#1FE06060"/>
            <Setter Property="BorderBrush" Value="#40E06060"/>
        </Style>
        <Style Selector="Border.Badge.Fsr TextBlock">
            <Setter Property="Foreground" Value="#F08080"/>
        </Style>
        <Style Selector="Border.Badge.Fsr.Injected">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#40E06060"/>
        </Style>
        <Style Selector="Border.Badge.Fsr.Injected TextBlock">
            <Setter Property="Foreground" Value="#F08080"/>
            <Setter Property="Opacity" Value="0.75"/>
        </Style>
        <Style Selector="Border.Badge.Fsr.Swapped">
            <Setter Property="Background" Value="#1FD4A04A"/>
            <Setter Property="BorderBrush" Value="#40D4A04A"/>
        </Style>
        <Style Selector="Border.Badge.Fsr.Swapped TextBlock">
            <Setter Property="Foreground" Value="#E6B35A"/>
        </Style>

        <Style Selector="Border.Badge.Xess">
            <Setter Property="Background" Value="#1F7080E0"/>
            <Setter Property="BorderBrush" Value="#407080E0"/>
        </Style>
        <Style Selector="Border.Badge.Xess TextBlock">
            <Setter Property="Foreground" Value="#8FA0F8"/>
        </Style>
        <Style Selector="Border.Badge.Xess.Injected">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#407080E0"/>
        </Style>
        <Style Selector="Border.Badge.Xess.Injected TextBlock">
            <Setter Property="Foreground" Value="#8FA0F8"/>
            <Setter Property="Opacity" Value="0.75"/>
        </Style>

        <Style Selector="Border.Badge.OptiScaler">
            <Setter Property="Background" Value="#2E8B73F8"/>
            <Setter Property="BorderBrush" Value="#808B73F8"/>
            <Setter Property="BoxShadow" Value="0 0 10 0 #258B73F8"/>
        </Style>
        <Style Selector="Border.Badge.OptiScaler TextBlock">
            <Setter Property="Foreground" Value="#C2B5FF"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style Selector="Border.Badge.Experimental">
            <Setter Property="Background" Value="#1F8983A6"/>
            <Setter Property="BorderBrush" Value="#408983A6"/>
        </Style>
        <Style Selector="Border.Badge.Experimental TextBlock">
            <Setter Property="Foreground" Value="#B4AED4"/>
        </Style>

        <!-- ════════════════════════════════════════════════════════
             SCROLLBAR: MODERN PREMIUM FLOATING
             ════════════════════════════════════════════════════════ -->
        
        <Style Selector="ScrollViewer">
            <Setter Property="AllowAutoHide" Value="False"/>
        </Style>

        <Style Selector="ScrollBar:vertical">
            <Setter Property="Width" Value="4"/>
            <Setter Property="MinWidth" Value="4"/>
            <Setter Property="MaxWidth" Value="4"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Grid>
                        <!-- Bare minimum Track and Thumb for total control -->
                        <Border Background="{TemplateBinding Background}" />
                        <Track Minimum="{TemplateBinding Minimum}"
                               Maximum="{TemplateBinding Maximum}"
                               Value="{TemplateBinding Value, Mode=TwoWay}"
                               ViewportSize="{TemplateBinding ViewportSize}"
                               Orientation="{TemplateBinding Orientation}"
                               IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb Name="thumb" Cursor="Hand">
                                    <Thumb.Template>
                                        <ControlTemplate>
                                            <Border Background="{TemplateBinding Background}"
                                                    CornerRadius="6"
                                                    HorizontalAlignment="Stretch"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter>
        </Style>

        <Style Selector="ScrollBar:vertical /template/ Thumb#thumb">
            <Setter Property="Background" Value="{StaticResource BrTextDisabled}"/>
        </Style>

        <Style Selector="ScrollBar:vertical:pointerover /template/ Thumb#thumb">
            <Setter Property="Background" Value="{StaticResource BrTextSecondary}"/>
        </Style>
        <Style Selector="ScrollBar:vertical /template/ Thumb#thumb:pointerover">
            <Setter Property="Background" Value="{StaticResource BrTextSecondary}"/>
        </Style>

        <Style Selector="ScrollBar:vertical:pressed /template/ Thumb#thumb">
            <Setter Property="Background" Value="{StaticResource BrAccent}"/>
        </Style>
        <Style Selector="ScrollBar:vertical /template/ Thumb#thumb:pressed">
            <Setter Property="Background" Value="{StaticResource BrAccent}"/>
        </Style>

        <!-- ════════════════════════════════════════════════════════
             FOCUS RING — keyboard / gamepad navigation
             Uses :focus pseudo-class (always fires when focus moves,
             regardless of ShowKeyboardCues — required for simulated
             key events raised by GamepadNavigationHelper).
             ════════════════════════════════════════════════════════ -->

        <!-- Disable adorner on controls that have inline :focus styles.
             IsHitTestVisible="False" is required here: a Border with Background="Transparent"
             is still a real (non-null) brush, so without this the adorner sits on top of the
             control in hit-test order and silently swallows every pointer event (hover cursor
             never changes, clicks never reach the control) for as long as it stays focused. -->
        <Style Selector="Button, RadioButton, ListBoxItem">
            <Setter Property="FocusAdorner">
                <FocusAdornerTemplate>
                    <Border Background="Transparent" IsHitTestVisible="False"/>
                </FocusAdornerTemplate>
            </Setter>
        </Style>

        <!-- Button: accent border ring -->
        <Style Selector="Button:focus /template/ ContentPresenter">
            <Setter Property="BorderBrush" Value="{StaticResource BrAccent}"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>

        <!-- Primary button: white focus ring so it stands out against the violet background -->
        <Style Selector="Button.BtnPrimary:focus /template/ ContentPresenter,
                         Button.BtnPrimary:focus-visible /template/ ContentPresenter">
            <Setter Property="BorderBrush" Value="White"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>

        <!-- IconGhost: tiny circular icon buttons (eye/zoom toggles) — the 2px accent ring above
             reads as a rendering glitch on a 16-26px circle instead of a visible-focus outline, so
             these opt out of it. Everything else keeps the ring (gamepad navigation relies on it to
             show the focused control). -->
        <Style Selector="Button.IconGhost:focus /template/ ContentPresenter">
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <!-- ListBoxItem: background lift + accent border ring -->
        <Style Selector="ListBoxItem:focus /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource BrBgElevated}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrAccent}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- TextBox / ComboBox: adorner ring with hardcoded color
             (StaticResource lookups are unreliable inside FocusAdornerTemplate;
             the negative Margin renders the ring outside the control bounds) -->
        <Style Selector="TextBox, ComboBox">
            <Setter Property="FocusAdorner">
                <FocusAdornerTemplate>
                    <Border BorderBrush="#8B73F8"
                            BorderThickness="2"
                            CornerRadius="8"
                            Background="Transparent"
                            Margin="-3"
                            IsHitTestVisible="False"/>
                </FocusAdornerTemplate>
            </Setter>
        </Style>

    </Application.Styles>
</Application>