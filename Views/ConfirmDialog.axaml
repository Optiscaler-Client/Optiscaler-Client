<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="OptiscalerClient.Views.ConfirmDialog"
        Title="Confirm"
        Width="440"
        MinHeight="220"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        SystemDecorations="None"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        CanResize="False"
        Topmost="True"
        ShowInTaskbar="False">

    <Panel Margin="20" Name="RootPanel" Opacity="0">
        <!-- Window Shadow -->
        <Border CornerRadius="12"
                Background="{StaticResource BrBgBase}"
                BoxShadow="0 8 32 0 #80000000"
                BorderBrush="{StaticResource BrBorderSubtle}"
                BorderThickness="1">
            
            <Grid Name="MainGrid" RowDefinitions="Auto, *, Auto">
                
                <!-- Custom Title Bar (Draggable) -->
                <Border Grid.Row="0"
                        Name="TitleBar"
                        Background="{StaticResource BrBgDeep}"
                        Height="45"
                        CornerRadius="12,12,0,0"
                        BorderBrush="{StaticResource BrBorderSubtle}"
                        BorderThickness="0,0,0,1">
                    <Grid ColumnDefinitions="*, Auto">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="16,0" VerticalAlignment="Center">
                            <TextBlock Name="TxtIcon"
                                       Text="&#xF63E;"
                                       FontFamily="{StaticResource FontIcons}"
                                       Foreground="{StaticResource BrAccent}"
                                       FontSize="18"
                                       Margin="0,0,12,0"/>
                            <TextBlock Name="TxtTitle"
                                       Text="Confirmation"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource BrTextPrimary}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        
                        <!-- Close button -->
                        <Button Grid.Column="1"
                                Name="BtnCloseTop"
                                Classes="BtnBase"
                                Width="45" Height="45"
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="0"
                                CornerRadius="0,12,0,0"
                                Click="BtnCancel_Click">
                            <Panel>
                                <TextBlock Name="TxtCloseIconX"
                                           Text="{OnPlatform '&#xE711;', Linux='✕'}"
                                           FontFamily="{OnPlatform 'Segoe Fluent Icons, Segoe MDL2 Assets, Segoe UI', Linux='sans-serif'}"
                                           FontSize="12"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                                <Border Name="BadgeCloseGamepadB"
                                        Background="#E05252"
                                        CornerRadius="10"
                                        Width="20" Height="20"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        IsVisible="False">
                                    <TextBlock Text="B"
                                               Foreground="White"
                                               FontWeight="Bold"
                                               FontSize="11"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                            </Panel>
                        </Button>
                    </Grid>
                </Border>

                <!-- Content -->
                <StackPanel Grid.Row="1"
                            Margin="24,20"
                            Spacing="8"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <TextBlock Name="TxtMessage"
                               Text="Are you sure?"
                               TextWrapping="Wrap"
                               FontSize="14"
                               Foreground="{StaticResource BrTextSecondary}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"/>
                    <!-- Optional compact info pill (e.g. a computed total size) — hidden unless a
                         caller passes badgeText, so every existing caller is unaffected. -->
                    <Border Name="BadgeInfo"
                            IsVisible="False"
                            Background="{StaticResource BrBgElevated}"
                            BorderBrush="{StaticResource BrBorderSubtle}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="12,4"
                            HorizontalAlignment="Center">
                        <TextBlock Name="TxtBadge"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource BrAccent}"/>
                    </Border>
                    <TextBlock Name="TxtLink"
                               IsVisible="False"
                               TextWrapping="Wrap"
                               FontSize="13"
                               TextDecorations="Underline"
                               Foreground="{StaticResource BrAccentPrimary}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               Cursor="Hand"
                               PointerPressed="TxtLink_PointerPressed"/>

                    <!-- Optional copyable snippet (e.g. a WINEDLLOVERRIDES line) — a plain TxtMessage
                         TextBlock can't be selected/copied by the user, so callers that need to hand
                         over an exact string to paste elsewhere pass copyableText instead of (or in
                         addition to) burying it in the message. Hidden unless provided, so every
                         existing caller is unaffected. -->
                    <Border Name="PnlCopyable"
                            IsVisible="False"
                            Background="{StaticResource BrBgElevated}"
                            BorderBrush="{StaticResource BrBorderSubtle}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10,8"
                            MaxWidth="380"
                            HorizontalAlignment="Stretch">
                        <Grid ColumnDefinitions="*,Auto">
                            <SelectableTextBlock Name="TxtCopyable"
                                                  Grid.Column="0"
                                                  FontFamily="Consolas,Monospace"
                                                  FontSize="12"
                                                  TextWrapping="Wrap"
                                                  Foreground="{StaticResource BrTextPrimary}"
                                                  VerticalAlignment="Center"/>
                            <Button Name="BtnCopy"
                                    Grid.Column="1"
                                    Classes="BtnSecondary"
                                    Padding="8,4"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    ToolTip.Tip="{DynamicResource TxtCopy}"
                                    Click="BtnCopy_Click">
                                <TextBlock Name="TxtCopyIcon" Text="⧉" FontSize="14"/>
                            </Button>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- Action Buttons -->
                <Border Grid.Row="2"
                        Padding="20,16"
                        Background="{StaticResource BrBgDeep}"
                        CornerRadius="0,0,12,12"
                        BorderBrush="{StaticResource BrBorderSubtle}"
                        BorderThickness="0,1,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                        <Button Name="BtnCancel"
                                Content="Cancel"
                                Classes="BtnBase"
                                MinWidth="90"
                                Click="BtnCancel_Click"/>
                        <!-- Optional third action (e.g. "Continue" for "I handled this myself") — hidden
                             unless a caller passes thirdButtonText, so every existing two-button caller
                             is unaffected. -->
                        <Button Name="BtnThird"
                                Content="Continue"
                                Classes="BtnBase"
                                MinWidth="90"
                                IsVisible="False"
                                Click="BtnThird_Click"/>
                        <Button Name="BtnConfirm"
                                Content="Confirm"
                                Classes="BtnPrimary"
                                MinWidth="110"
                                Click="BtnConfirm_Click"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Panel>
</Window>
