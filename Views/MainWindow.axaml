<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OptiscalerClient"
        xmlns:converters="clr-namespace:OptiscalerClient.Converters"
        xmlns:models="clr-namespace:OptiscalerClient.Models"
        mc:Ignorable="d"
        x:Class="OptiscalerClient.Views.MainWindow"
        Name="MainWin"
        Title="{DynamicResource TxtAppTitle}"
        Height="720" Width="1280"
        MinHeight="520" MinWidth="760"
        Background="{StaticResource BrBgBase}"
        Foreground="{StaticResource BrTextPrimary}"
        FontFamily="{StaticResource FontPrimary}"
        Icon="avares://OptiscalerClient/assets/icon.png">

    <Window.Resources>
        <converters:NullToVisibilityConverter  x:Key="NullToVisibilityConverter"/>
        <converters:BoolToVisibilityConverter  x:Key="BoolToVisibilityConverter"/>
        <converters:BitmapValueConverter       x:Key="BitmapValueConverter"/>

        </Window.Resources>

    <Window.Styles>
        <Style Selector="RadioButton.NavBtnStyle">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource BrTextSecondary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="Width" Value="48"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="FontFamily" Value="{StaticResource FontIcons}"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="RootBorder" Background="{TemplateBinding Background}" CornerRadius="8">
                        <Grid>
                            <Border Name="Indicator" Width="3" Height="24" HorizontalAlignment="Left" VerticalAlignment="Center" Background="{StaticResource BrAccent}" IsVisible="False" CornerRadius="1.5" Margin="2,0,0,0"/>
                            <TextBlock Text="{TemplateBinding Content}" FontFamily="{StaticResource FontIcons}" FontSize="{TemplateBinding FontSize}" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip.Tip="{TemplateBinding ToolTip.Tip}"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="RadioButton.NavBtnStyle:checked /template/ Border#Indicator">
            <Setter Property="IsVisible" Value="True"/>
        </Style>
        <Style Selector="RadioButton.NavBtnStyle:checked">
            <Setter Property="Foreground" Value="{StaticResource BrAccent}"/>
            <Setter Property="Background" Value="{StaticResource BrBgElevated}"/>
        </Style>
        <Style Selector="RadioButton.NavBtnStyle:pointerover">
            <Setter Property="Foreground" Value="{StaticResource BrTextPrimary}"/>
            <Setter Property="Background" Value="{StaticResource BrBgCard}"/>
        </Style>
        <!-- Gamepad / keyboard focus ring for sidebar nav buttons.
             Inset BoxShadow is never clipped by parent containers. -->
        <Style Selector="RadioButton.NavBtnStyle:focus /template/ Border#RootBorder">
            <Setter Property="Background" Value="{StaticResource BrBgElevated}"/>
            <Setter Property="BoxShadow" Value="inset 0 0 0 2 #8B73F8"/>
        </Style>
        <Style Selector="RadioButton.NavBtnStyle:checked:focus /template/ Border#RootBorder">
            <Setter Property="BoxShadow" Value="inset 0 0 0 2 #9D88FF"/>
        </Style>

        <!-- Organize mode: hide action buttons, show edit controls via ListBox class -->
        <Style Selector="ListBox#LstGames ListBoxItem StackPanel.EditModePanel">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector="ListBox#LstGames.EditMode ListBoxItem StackPanel.EditModePanel">
            <Setter Property="IsVisible" Value="True"/>
        </Style>
        <Style Selector="ListBox#LstGames.EditMode ListBoxItem Button.NormalModeAction">
            <Setter Property="IsVisible" Value="False"/>
        </Style>

        <!-- Grid organize mode overlay -->
        <Style Selector="ListBox#LstGamesGrid ListBoxItem Border.GridEditOverlay">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector="ListBox#LstGamesGrid.EditMode ListBoxItem Border.GridEditOverlay">
            <Setter Property="IsVisible" Value="True"/>
        </Style>

        <!-- Scan modal dot bounce animations (animate Margin via built-in ThicknessAnimator) -->
        <Style Selector="Ellipse#ScanDot1">
            <Style.Animations>
                <Animation Duration="0:0:0.6" IterationCount="INFINITE" Easing="SineEaseInOut">
                    <KeyFrame Cue="0%">
                        <Setter Property="Margin" Value="4,12,4,0"/>
                    </KeyFrame>
                    <KeyFrame Cue="50%">
                        <Setter Property="Margin" Value="4,2,4,10"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Margin" Value="4,12,4,0"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Ellipse#ScanDot2">
            <Style.Animations>
                <Animation Duration="0:0:0.6" Delay="0:0:0.2" IterationCount="INFINITE" Easing="SineEaseInOut">
                    <KeyFrame Cue="0%">
                        <Setter Property="Margin" Value="4,12,4,0"/>
                    </KeyFrame>
                    <KeyFrame Cue="50%">
                        <Setter Property="Margin" Value="4,2,4,10"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Margin" Value="4,12,4,0"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Ellipse#ScanDot3">
            <Style.Animations>
                <Animation Duration="0:0:0.6" Delay="0:0:0.4" IterationCount="INFINITE" Easing="SineEaseInOut">
                    <KeyFrame Cue="0%">
                        <Setter Property="Margin" Value="4,12,4,0"/>
                    </KeyFrame>
                    <KeyFrame Cue="50%">
                        <Setter Property="Margin" Value="4,2,4,10"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Margin" Value="4,12,4,0"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- Loading overlay dot bounce animations -->
        <Style Selector="Ellipse#LoadDot1">
            <Style.Animations>
                <Animation Duration="0:0:0.6" IterationCount="INFINITE" Easing="SineEaseInOut">
                    <KeyFrame Cue="0%"><Setter Property="Margin" Value="4,12,4,0"/></KeyFrame>
                    <KeyFrame Cue="50%"><Setter Property="Margin" Value="4,2,4,10"/></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="Margin" Value="4,12,4,0"/></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Ellipse#LoadDot2">
            <Style.Animations>
                <Animation Duration="0:0:0.6" Delay="0:0:0.2" IterationCount="INFINITE" Easing="SineEaseInOut">
                    <KeyFrame Cue="0%"><Setter Property="Margin" Value="4,12,4,0"/></KeyFrame>
                    <KeyFrame Cue="50%"><Setter Property="Margin" Value="4,2,4,10"/></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="Margin" Value="4,12,4,0"/></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Ellipse#LoadDot3">
            <Style.Animations>
                <Animation Duration="0:0:0.6" Delay="0:0:0.4" IterationCount="INFINITE" Easing="SineEaseInOut">
                    <KeyFrame Cue="0%"><Setter Property="Margin" Value="4,12,4,0"/></KeyFrame>
                    <KeyFrame Cue="50%"><Setter Property="Margin" Value="4,2,4,10"/></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="Margin" Value="4,12,4,0"/></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- Focusable card wrapper for gamepad-navigable settings rows whose
             interactive control (e.g. ToggleSwitch) doesn't reliably report
             IsFocused on itself when reached via simulated Tab — see
             gamepad_implementation_log.md, section 13/20. Scoped to the class
             (not :is(Control)) to avoid touching the window's existing
             Button/RadioButton/ListBoxItem focus-ring styles. -->
        <Style Selector="Border.InteractiveOption">
            <Setter Property="FocusAdorner" Value="{x:Null}"/>
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15"/>
                    <BrushTransition Property="Background" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>

        <!-- Use CardOption for items that should have a background even when not focused -->
        <Style Selector="Border.CardOption">
            <Setter Property="Background" Value="{StaticResource BrBgCard}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrBorderSubtle}"/>
        </Style>

        <Style Selector="Border.InteractiveOption:focus">
            <Setter Property="BorderBrush" Value="{StaticResource BrAccent}"/>
            <Setter Property="Background" Value="{StaticResource BrBgElevated}"/>
        </Style>

        <!-- Game card gamepad focus ring — v2.
             The generic "ListBoxItem:focus /template/ ContentPresenter" rule in
             App.axaml paints its highlight across the FULL ListBoxItem cell —
             including the item's own bottom/right spacing padding used to gap
             cards apart (Padding="0,0,0,8" for the list, "0,0,12,12" for the
             grid) — not just the visible card sitting inside it. That's why a
             CornerRadius-only fix (v1) still looked oversized/offset: the ring
             was bigger than the card and the card sat off-center inside it.
             Fix: neutralize that generic ring for these two ListBoxes and
             paint the highlight directly on Border.GameCard/GameGridCard
             instead, via BoxShadow. BoxShadow is a pure paint effect (it does
             NOT participate in layout, unlike BorderThickness), so it always
             traces the card's own rounded silhouette exactly — there is no
             separate overlay rectangle left to go out of sync.
             The shadow must be INSET, not a plain outward spread: the item's
             own spacing padding is asymmetric (slack room only on the
             bottom/right, none on the top/left — see above), so an outward
             ring would have room to render on those two sides but get
             clipped on the top/left, where the card sits flush against the
             ListBoxItem's own bounds. Same reasoning already documented for
             the sidebar nav buttons' focus ring above ("Inset BoxShadow is
             never clipped by parent containers"). -->
        <Style Selector="ListBox#LstGames ListBoxItem:focus /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="ListBox#LstGamesGrid ListBoxItem:focus /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="ListBox#LstGames ListBoxItem:focus Border.GameCard">
            <Setter Property="BorderBrush" Value="{StaticResource BrAccent}"/>
            <Setter Property="Background" Value="{StaticResource BrBgElevated}"/>
            <Setter Property="BoxShadow" Value="inset 0 0 0 2 #8B73F8"/>
        </Style>
        <Style Selector="ListBox#LstGamesGrid ListBoxItem:focus Border.GameGridCard">
            <Setter Property="BorderBrush" Value="{StaticResource BrAccent}"/>
            <Setter Property="Background" Value="{StaticResource BrBgElevated}"/>
            <Setter Property="BoxShadow" Value="inset 0 0 0 2 #8B73F8"/>
        </Style>
    </Window.Styles>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="68"/> <!-- Sidebar -->
            <ColumnDefinition Width="*"/>  <!-- Main Content Area -->
        </Grid.ColumnDefinitions>

        <!-- SIDEBAR -->
        <Border Grid.Column="0" Background="{StaticResource BrBgDeep}" BorderBrush="{StaticResource BrBorderSubtle}" BorderThickness="0,0,1,0" ZIndex="10">
            <Grid Margin="0,16">
                <!-- Top actions: Logo + Games + Profiles -->
                <StackPanel VerticalAlignment="Top" HorizontalAlignment="Center">
                    <Image Source="avares://OptiscalerClient/assets/icon.png" Width="32" Height="32" Margin="0,0,0,24" RenderOptions.BitmapInterpolationMode="HighQuality"/>

                    <RadioButton Name="NavGames" GroupName="SidebarNav" Classes="NavBtnStyle" Content="&#xEEB9;" ToolTip.Tip="Games" IsChecked="True" Click="NavGames_Click"/>
                    <RadioButton Name="NavProfiles" GroupName="SidebarNav" Classes="NavBtnStyle" Content="&#xF710;" ToolTip.Tip="Profiles" Click="NavProfiles_Click"/>
                </StackPanel>

                <!-- Bottom actions: Settings, Help -->
                <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center">
                    <RadioButton Name="NavHelp" GroupName="SidebarNav" Classes="NavBtnStyle" Content="&#xF639;" ToolTip.Tip="{DynamicResource TxtAboutTitle}" Click="NavHelp_Click"/>
                    <RadioButton Name="NavSettings" GroupName="SidebarNav" Classes="NavBtnStyle" Content="&#xF6AA;" ToolTip.Tip="{DynamicResource TxtSettingsTitle}" Click="NavSettings_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN CONTENT AREA -->
        <Grid Grid.Column="1">

             <!-- ════════════════════════════════════════════════════════
                  1. GAMES VIEW
                  ════════════════════════════════════════════════════════ -->
             <Grid Name="ViewGames">
                 <Grid.Transitions>
                     <Transitions>
                         <DoubleTransition Property="Opacity" Duration="0:0:0.18" Easing="CubicEaseOut"/>
                     </Transitions>
                 </Grid.Transitions>
                 <Grid.RowDefinitions>
                     <RowDefinition Height="Auto"/>
                     <RowDefinition Height="Auto"/>
                     <RowDefinition Height="Auto"/>
                     <RowDefinition Height="*"/>
                     <RowDefinition Height="Auto"/>
                 </Grid.RowDefinitions>

                 <!-- Header -->
                 <Border Grid.Row="0"
                         Background="{StaticResource BrBgDeep}"
                         BorderBrush="{StaticResource BrBorderSubtle}"
                         BorderThickness="0,0,0,1"
                         Padding="24,16">
                     <Grid>
                         <Grid.ColumnDefinitions>
                             <ColumnDefinition Width="Auto"/>
                             <ColumnDefinition Width="*"/>
                             <ColumnDefinition Width="Auto"/>
                         </Grid.ColumnDefinitions>

                         <!-- Left: Title + action buttons -->
                         <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                             <!-- Action buttons -->
                             <Button Name="BtnScan"
                                     Content="{DynamicResource TxtBtnScan}"
                                     Classes="BtnBase"
                                     Padding="14,7"
                                     Margin="0,0,10,0"
                                     Click="BtnScan_Click"/>

                             <Button Name="BtnAddManual"
                                     Content="{DynamicResource TxtBtnAddManual}"
                                     Classes="BtnBase"
                                     Padding="14,7"
                                     Margin="0,0,10,0"
                                     Click="BtnAddManual_Click"/>

                             <Button Name="BtnBulkInstall"
                                     Classes="BtnBase"
                                     Padding="14,7"
                                     Click="BtnBulkInstall_Click">
                                 <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Path Data="M13 0 L5 9 H11 L9 16 L17 7 H11 Z"
                                          Fill="{StaticResource BrTextPrimary}"
                                          Stretch="Uniform"
                                          Width="10" Height="14"
                                          VerticalAlignment="Center"
                                          Margin="0,0,6,0"/>
                                     <TextBlock Text="{DynamicResource TxtBtnBulkInstall}"
                                                VerticalAlignment="Center"
                                                Foreground="{StaticResource BrTextPrimary}"/>
                                 </StackPanel>
                             </Button>
                         </StackPanel>

                         <!-- Middle: Search Bar -->
                         <Grid Grid.Column="1" Margin="32,0" MaxWidth="400" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                             <TextBox Name="TxtSearch"
                                      Padding="32,7,12,7"
                                      Background="{StaticResource BrBgSurface}"
                                      Foreground="{StaticResource BrTextPrimary}"
                                      BorderBrush="{StaticResource BrBorderSubtle}"
                                      BorderThickness="1"
                                      VerticalAlignment="Center"
                                      VerticalContentAlignment="Center"
                                      GotFocus="TxtSearch_GotFocus"
                                      LostFocus="TxtSearch_LostFocus"
                                      TextChanged="TxtSearch_TextChanged">
                                 <TextBox.Styles>
                                     <Style Selector="TextBox /template/ Border#PART_BorderElement">
                                         <Setter Property="CornerRadius" Value="{StaticResource RadiusMedium}"/>
                                     </Style>
                                 </TextBox.Styles>
                             </TextBox>
                             <TextBlock IsHitTestVisible="False"
                                        Text="&#xF68F;"
                                        FontFamily="{StaticResource FontIcons}"
                                        Foreground="{StaticResource BrTextSecondary}"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Left"
                                        Margin="12,0,0,0"
                                        FontSize="14"/>
                             <TextBlock Name="TxtSearchPlaceholder"
                                        IsHitTestVisible="False"
                                        Text="{DynamicResource TxtSearchGames}"
                                        Foreground="{StaticResource BrTextSecondary}"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Left"
                                        Margin="34,0,0,0"/>
                         </Grid>

                         <!-- Right: GPU chip + Gamepad + View Modes -->
                         <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                             
                             <Border Background="{StaticResource BrBgSurface}"
                                     BorderBrush="{StaticResource BrBorderSubtle}"
                                     BorderThickness="1"
                                     CornerRadius="{StaticResource RadiusMedium}"
                                     Padding="12,5"
                                     Margin="0,0,10,0">
                                 <Path Name="TxtGamepadIcon"
                                       Data="M21.58,9.39C21.32,7.63 19.86,6.34 18.06,6.34H5.94C4.14,6.34 2.68,7.63 2.42,9.39L1.08,18.08C0.84,19.64 2.05,21 3.63,21C4.42,21 5.16,20.65 5.66,20.04L8.35,16.85H15.65L18.34,20.04C18.84,20.65 19.58,21 20.37,21C21.95,21 23.16,19.64 22.92,18.08L21.58,9.39M8.5,13.5H6.5V15.5H5V13.5H3V12H5V10H6.5V12H8.5V13.5M16,14C15.17,14 14.5,13.33 14.5,12.5C14.5,11.67 15.17,11 16,11C16.83,11 17.5,11.67 17.5,12.5C17.5,13.33 16.83,14 16,14M19,11C18.17,11 17.5,10.33 17.5,9.5C17.5,8.67 18.17,8 19,8C19.83,8 20.5,8.67 20.5,9.5C20.5,10.33 19.83,11 19,11Z"
                                       Fill="{StaticResource BrTextSecondary}"
                                       Stretch="Uniform"
                                       Width="18"
                                       Height="18"
                                       Margin="0,2,0,0"
                                       VerticalAlignment="Center"
                                       ToolTip.Tip="{DynamicResource TxtGamepadDisconnected}" />
                             </Border>

                             <Border Background="{StaticResource BrBgSurface}"
                                     BorderBrush="{StaticResource BrBorderSubtle}"
                                     BorderThickness="1"
                                     CornerRadius="{StaticResource RadiusMedium}"
                                     Padding="4"
                                     Margin="0,0,10,0">
                                 <StackPanel Orientation="Horizontal" Spacing="4">
                                     <Button Name="BtnViewList"
                                             Width="32"
                                             Height="28"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Foreground="{StaticResource BrTextPrimary}"
                                             ToolTip.Tip="{DynamicResource TxtViewList}"
                                             Click="BtnViewList_Click">
                                         <Grid Width="14" Height="12" RowDefinitions="Auto,Auto,Auto">
                                             <Border Grid.Row="0" Height="2" CornerRadius="1" Background="{StaticResource BrTextPrimary}" Margin="0,0,0,3"/>
                                             <Border Grid.Row="1" Height="2" CornerRadius="1" Background="{StaticResource BrTextPrimary}" Margin="0,0,0,3"/>
                                             <Border Grid.Row="2" Height="2" CornerRadius="1" Background="{StaticResource BrTextPrimary}"/>
                                         </Grid>
                                     </Button>
                                     <Button Name="BtnViewGrid"
                                             Width="32"
                                             Height="28"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Foreground="{StaticResource BrTextPrimary}"
                                             ToolTip.Tip="{DynamicResource TxtViewGrid}"
                                             Click="BtnViewGrid_Click">
                                         <Grid Width="14" Height="14"
                                               ColumnDefinitions="Auto,Auto"
                                               RowDefinitions="Auto,Auto"
                                               ColumnSpacing="3"
                                               RowSpacing="3">
                                             <Border Grid.Row="0" Grid.Column="0" Width="5" Height="5" CornerRadius="1" Background="{StaticResource BrTextPrimary}"/>
                                             <Border Grid.Row="0" Grid.Column="1" Width="5" Height="5" CornerRadius="1" Background="{StaticResource BrTextPrimary}"/>
                                             <Border Grid.Row="1" Grid.Column="0" Width="5" Height="5" CornerRadius="1" Background="{StaticResource BrTextPrimary}"/>
                                             <Border Grid.Row="1" Grid.Column="1" Width="5" Height="5" CornerRadius="1" Background="{StaticResource BrTextPrimary}"/>
                                         </Grid>
                                     </Button>

                                     <!-- Separator -->
                                     <Border Width="1" Height="18" Background="{StaticResource BrBorderSubtle}" Margin="2,0"/>

                                     <!-- Edit / Organize mode -->
                                     <Button Name="BtnEditMode"
                                             Width="32"
                                             Height="28"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             ToolTip.Tip="{DynamicResource TxtOrganizeGamesTooltip}"
                                             Click="BtnEditMode_Click">
                                            <Grid Width="18" Height="18">
                                                <TextBlock Text="&#xF3DD;"
                                                           FontFamily="{StaticResource FontIcons}"
                                                           FontSize="14"
                                                           Foreground="{StaticResource BrTextPrimary}"
                                                           VerticalAlignment="Center"
                                                           HorizontalAlignment="Center"/>
                                            </Grid>
                                     </Button>
                                 </StackPanel>
                             </Border>

                             <Border Background="{StaticResource BrBgSurface}"
                                     BorderBrush="{StaticResource BrBorderSubtle}"
                                     BorderThickness="1"
                                     CornerRadius="{StaticResource RadiusMedium}"
                                     Padding="12,5" Margin="0,0,10,0">
                                 <TextBlock Name="TxtGpuInfo"
                                            FontSize="{StaticResource FontSizeCaption}"
                                            Foreground="{StaticResource BrTextSecondary}"
                                            VerticalAlignment="Center"/>
                             </Border>
                         </StackPanel>
                     </Grid>
                 </Border>

                 <!-- Edit Mode Banner -->
                 <Border Name="EditModeBanner"
                         Grid.Row="1"
                         IsVisible="False"
                         Background="#1A7C3AED"
                         BorderBrush="{StaticResource BrAccent}"
                         BorderThickness="0,0,0,1"
                         Padding="20,8">
                     <Grid>
                         <Grid.ColumnDefinitions>
                             <ColumnDefinition Width="*"/>
                             <ColumnDefinition Width="Auto"/>
                         </Grid.ColumnDefinitions>
                         <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                            <TextBlock Text="&#xF3DD;"
                                       FontFamily="{StaticResource FontIcons}"
                                       FontSize="14"
                                       Foreground="{StaticResource BrAccent}"
                                       VerticalAlignment="Center"/>
                             <TextBlock Text="{DynamicResource TxtOrganizeModeBanner}"
                                        Foreground="{StaticResource BrAccent}"
                                        FontWeight="SemiBold"
                                        VerticalAlignment="Center"/>
                             <TextBlock Text="·"
                                        Foreground="{StaticResource BrTextSecondary}"
                                        VerticalAlignment="Center"/>
                             <TextBlock Text="{DynamicResource TxtOrganizeModeReorder}"
                                        Foreground="{StaticResource BrTextSecondary}"
                                        FontSize="11"
                                        VerticalAlignment="Center"/>
                             <TextBlock Text="·"
                                        Foreground="{StaticResource BrTextSecondary}"
                                        VerticalAlignment="Center"/>
                             <TextBlock Text="{DynamicResource TxtOrganizeModeHideShow}"
                                        FontFamily="{StaticResource FontIcons}"
                                        Foreground="{StaticResource BrTextSecondary}"
                                        FontSize="11"
                                        VerticalAlignment="Center"/>
                         </StackPanel>
                         <Button x:Name="BtnEditModeDone"
                                 Grid.Column="1"
                                 Content="{DynamicResource TxtOrganizeModeDone}"
                                 Classes="BtnBase"
                                 Padding="18,5"
                                 Click="BtnEditModeDone_Click"/>
                     </Grid>
                 </Border>

                 <!-- Linux Steam-only notice -->
                 <!-- <Border Name="LinuxNotice"
                         Grid.Row="2"
                         IsVisible="False"
                         Background="#1A3B6B"
                         BorderBrush="#2E5FA3"
                         BorderThickness="0,0,0,1"
                         Padding="24,10">
                     <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                         <TextBlock Text="&#xE783;"
                                    FontFamily="{StaticResource FontIcons}"
                                    FontSize="16"
                                    Foreground="#90B8F8"
                                    VerticalAlignment="Center"/>
                         <TextBlock Text="{DynamicResource TxtLinuxSteamOnlyNotice}"
                                    Foreground="#C8DEFF"
                                    FontSize="13"
                                    VerticalAlignment="Center"
                                    TextWrapping="Wrap"/>
                     </StackPanel>
                 </Border> -->

                 <!-- Game List -->
                 <ScrollViewer Name="GameListScrollViewer"
                               Grid.Row="3"
                               VerticalScrollBarVisibility="Auto"
                               HorizontalScrollBarVisibility="Disabled"
                               PointerWheelChanged="GameListScrollViewer_PointerWheelChanged">
                     <ListBox Name="LstGames"
                              Margin="12"
                              Background="Transparent"
                              BorderThickness="0"
                              ScrollViewer.VerticalScrollBarVisibility="Disabled"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                          <ListBox.Styles>
                              <Style Selector="ListBoxItem">
                                  <Setter Property="Padding" Value="0,0,0,8"/>
                                  <Setter Property="Background" Value="Transparent"/>
                              </Style>
                              <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                                  <Setter Property="Background" Value="Transparent"/>
                              </Style>
                              <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
                                  <Setter Property="Background" Value="Transparent"/>
                              </Style>
                          </ListBox.Styles>


                         <ListBox.ItemTemplate>
                             <DataTemplate x:DataType="models:Game">
                                 <!-- Game Card -->
                                 <Border Classes="GameCard"
                                         Background="{StaticResource BrBgCard}"
                                         BorderBrush="{StaticResource BrBorderSubtle}"
                                         BorderThickness="1"
                                         CornerRadius="{StaticResource RadiusLarge}"
                                         RenderTransformOrigin="50%,50%"
                                         Padding="20,16">
                                     <Border.Styles>
                                         <Style Selector="Border.GameCard:pointerover">
                                             <Setter Property="BorderBrush" Value="{StaticResource BrBorderDefault}"/>
                                             <Setter Property="Background"  Value="{StaticResource BrBgElevated}"/>
                                             <Setter Property="RenderTransform" Value="scale(1.007)"/>
                                         </Style>
                                         <Style Selector="Border.GameCard">
                                             <Setter Property="RenderTransform" Value="scale(1)"/>
                                             <Setter Property="Transitions">
                                                 <Transitions>
                                                     <BrushTransition Property="Background" Duration="0:0:0.15"/>
                                                     <BrushTransition Property="BorderBrush" Duration="0:0:0.15"/>
                                                     <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18"/>
                                                 </Transitions>
                                             </Setter>
                                         </Style>
                                     </Border.Styles>

                                         <Grid>
                                             <Grid.ColumnDefinitions>
                                                 <ColumnDefinition Width="Auto"/> <!-- Cover Art -->
                                                 <ColumnDefinition Width="*"/>
                                                 <ColumnDefinition Width="Auto"/>
                                             </Grid.ColumnDefinitions>

                                             <!-- Cover Art -->
                                             <Border Grid.Column="0" Width="80" Height="120" Margin="0,0,20,0"
                                                     CornerRadius="4" ClipToBounds="True"
                                                     Background="{StaticResource BrBgElevated}"
                                                     BorderBrush="{StaticResource BrBorderSubtle}"
                                                     BorderThickness="1">
                                                 <!--
                                                     <RectangleGeometry RadiusX="4" RadiusY="4" Rect="0,0,80,120"/>
                                                 -->
                                                 <Grid>
                                                     <!-- Fallback Icon -->
                                                     <TextBlock Text="🎮"
                                                                FontSize="36"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"
                                                                Foreground="{StaticResource BrTextSecondary}"
                                                                Opacity="0.5"/>

                                                     <!-- Image (overlays fallback if valid) -->
                                                     <Image Source="{Binding CoverImageUrl, Converter={StaticResource BitmapValueConverter}}" Stretch="UniformToFill" />
                                                 </Grid>
                                             </Border>

                                             <!-- Game info -->
                                             <StackPanel Grid.Column="1" VerticalAlignment="Center">

                                             <!-- Name and Platform -->
                                             <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,3">
                                                 <!-- Platform Badge -->
                                                 <Border Background="{StaticResource BrBgSurface}"
                                                         BorderBrush="{StaticResource BrBorderSubtle}"
                                                         BorderThickness="1"
                                                         CornerRadius="4" ClipToBounds="True"
                                                         Padding="6,2" Margin="0,0,8,0"
                                                         VerticalAlignment="Center">
                                                     <TextBlock Text="{Binding Platform}"
                                                                Foreground="{StaticResource BrTextSecondary}"
                                                                FontSize="10"
                                                                FontWeight="SemiBold"/>
                                                 </Border>

                                                 <!-- Name -->
                                                 <TextBlock Text="{Binding Name}"
                                                            FontSize="{StaticResource FontSizeSubtitle}"
                                                            FontWeight="SemiBold"
                                                            Foreground="{StaticResource BrTextPrimary}"
                                                            VerticalAlignment="Center"/>
                                             </StackPanel>

                                             <!-- Badges row -->
                                             <StackPanel Orientation="Horizontal" Margin="0,10,0,0">

                                                 <!-- DLSS badge -->
                                                 <Border Background="#1A2E1A"
                                                         BorderBrush="#2D5A2D"
                                                         BorderThickness="1"
                                                         CornerRadius="6"
                                                         Padding="10,3" Margin="0,0,6,0"
                                                         IsVisible="{Binding DlssVersion, Converter={StaticResource NullToVisibilityConverter}}">
                                                     <TextBlock Text="DLSS"
                                                                Foreground="#7FD481"
                                                                FontSize="{StaticResource FontSizeCaption}"
                                                                FontWeight="SemiBold"/>
                                                 </Border>

                                                 <Border Background="#1E1530"
                                                         BorderBrush="{StaticResource BrAccent}"
                                                         BorderThickness="1"
                                                         CornerRadius="6"
                                                         Padding="10,3" Margin="0,0,6,0"
                                                         IsVisible="{Binding IsOptiscalerInstalled, Converter={StaticResource BoolToVisibilityConverter}}">
                                                     <StackPanel Orientation="Horizontal">
                                                         <TextBlock Text="✦ OptiScaler"
                                                                    Foreground="{StaticResource BrAccent}"
                                                                    FontSize="{StaticResource FontSizeCaption}"
                                                                    FontWeight="Bold"/>
                                                         <TextBlock Text="{Binding OptiscalerVersion, StringFormat=' {0}'}"
                                                                    Foreground="{StaticResource BrAccent}"
                                                                    FontSize="{StaticResource FontSizeCaption}"
                                                                    FontWeight="SemiBold"
                                                                    IsVisible="{Binding OptiscalerVersion, Converter={StaticResource NullToVisibilityConverter}}"/>
                                                     </StackPanel>
                                                 </Border>

                                             </StackPanel>
                                         </StackPanel>

                                         <!-- Actions -->
                                         <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                             <Button Content="&#xE74D;"
                                                     FontFamily="{StaticResource FontIcons}"
                                                     Foreground="{StaticResource BrTextSecondary}"
                                                     Background="Transparent"
                                                     BorderThickness="0"
                                                     FontSize="16"
                                                     Padding="10"
                                                     Margin="0,0,10,0"
                                                     ToolTip.Tip="{DynamicResource TxtRemoveGameTip}"
                                                     IsVisible="{Binding IsManual, Converter={StaticResource BoolToVisibilityConverter}}"
                                                     Click="BtnRemoveGame_Click">
                                                 <Button.Styles>
                                                     <Style Selector="Button:pointerover">
                                                         <Setter Property="Background" Value="#1AFFFFFF"/>
                                                         <Setter Property="Foreground" Value="{StaticResource BrAccentWarm}"/>
                                                     </Style>
                                                 </Button.Styles>
                                             </Button>
                                             <Button Name="BtnFastInstall"
                                                    Classes="BtnBase NormalModeAction"
                                                    Padding="16,8"
                                                    Margin="0,0,8,0"
                                                    VerticalAlignment="Center"
                                                    Foreground="{StaticResource BrAccent}"
                                                    Content="{DynamicResource TxtQuickInstall}"
                                                    Click="BtnFastInstall_Click"
                                                    Loaded="BtnFastInstall_Loaded"/>
                                            <Button Name="BtnManageGame"
                                                    Classes="BtnBase NormalModeAction"
                                                    Padding="20,8"
                                                    VerticalAlignment="Center"
                                                    Click="BtnManage_Click">
                                                <Grid ColumnDefinitions="Auto,*" VerticalAlignment="Center" Margin="0,0,0,0">
                                                    <TextBlock Grid.Column="0"
                                                               Text="&#xF6AA;"
                                                               FontFamily="{StaticResource FontIcons}"
                                                               FontSize="15"
                                                               Foreground="{StaticResource BrTextPrimary}"
                                                               VerticalAlignment="Center"
                                                               Margin="0,0,8,0"/>
                                                    <TextBlock Grid.Column="1"
                                                               Text="{DynamicResource TxtManageGame}"
                                                               Foreground="{StaticResource BrTextPrimary}"
                                                               VerticalAlignment="Center"/>
                                                </Grid>
                                            </Button>

                                            <!-- Edit Mode controls (collapsed when not in edit mode; visibility driven by CSS class on LstGames) -->
                                            <StackPanel Name="EditModeControls"
                                                        Classes="EditModePanel"
                                                        Orientation="Horizontal"
                                                        Margin="8,0,0,0"
                                                        Spacing="2">
                                                <!-- Drag handle -->
                                                <Border Name="DragHandle"
                                                        Width="24" Height="36"
                                                        Background="Transparent"
                                                        Cursor="SizeAll"
                                                        ToolTip.Tip="{DynamicResource TxtDragToReorder}"
                                                        PointerPressed="DragHandle_PointerPressed"
                                                        Margin="0,0,4,0">
                                                    <TextBlock Text="&#x283F;"
                                                               FontSize="20"
                                                               TextAlignment="Center"
                                                               Foreground="{StaticResource BrTextSecondary}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                </Border>
                                                <Button Name="BtnMoveUp"
                                                        Width="32" Height="32"
                                                        Padding="0"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        ToolTip.Tip="{DynamicResource TxtMoveUp}"
                                                        Click="BtnMoveUp_Click">
                                                    <Button.Styles>
                                                        <Style Selector="Button:pointerover">
                                                            <Setter Property="Background" Value="#1AFFFFFF"/>
                                                        </Style>
                                                    </Button.Styles>
                                                    <TextBlock Text="&#x25B2;"
                                                               FontSize="11"
                                                               Foreground="{StaticResource BrTextSecondary}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                </Button>
                                                <Button Name="BtnMoveDown"
                                                        Width="32" Height="32"
                                                        Padding="0"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        ToolTip.Tip="{DynamicResource TxtMoveDown}"
                                                        Click="BtnMoveDown_Click">
                                                    <Button.Styles>
                                                        <Style Selector="Button:pointerover">
                                                            <Setter Property="Background" Value="#1AFFFFFF"/>
                                                        </Style>
                                                    </Button.Styles>
                                                    <TextBlock Text="&#x25BC;"
                                                               FontSize="11"
                                                               Foreground="{StaticResource BrTextSecondary}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                </Button>
                                                <Button Name="BtnToggleHide"
                                                        Width="36" Height="32"
                                                        Padding="0"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        ToolTip.Tip="{DynamicResource TxtHideShowGame}"
                                                        Click="BtnToggleHide_Click">
                                                    <Button.Styles>
                                                        <Style Selector="Button:pointerover">
                                                            <Setter Property="Background" Value="#1AFFFFFF"/>
                                                        </Style>
                                                    </Button.Styles>
                                                    <TextBlock Name="TxtHideIcon"
                                                               Text="&#xE5F2;"
                                                               FontFamily="{StaticResource FontIcons}"
                                                               FontSize="16"
                                                               Foreground="{StaticResource BrTextSecondary}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                </Button>
                                            </StackPanel>
                                         </StackPanel>
                                     </Grid>
                                 </Border>
                             </DataTemplate>
                         </ListBox.ItemTemplate>
                     </ListBox>
                 </ScrollViewer>

                 <!-- Game Grid -->
                 <ScrollViewer Name="GameGridScrollViewer"
                               Grid.Row="3"
                               VerticalScrollBarVisibility="Auto"
                               HorizontalScrollBarVisibility="Disabled"
                               PointerWheelChanged="GameListScrollViewer_PointerWheelChanged"
                               IsVisible="False">
                     <ListBox Name="LstGamesGrid"
                              Margin="12"
                              Background="Transparent"
                              BorderThickness="0"
                              HorizontalAlignment="Center"
                              ScrollViewer.VerticalScrollBarVisibility="Disabled"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                         <ListBox.ItemsPanel>
                             <ItemsPanelTemplate>
                                 <WrapPanel Orientation="Horizontal" ItemWidth="217" HorizontalAlignment="Center"/>
                             </ItemsPanelTemplate>
                         </ListBox.ItemsPanel>
                         <ListBox.Styles>
                             <Style Selector="ListBoxItem">
                                 <Setter Property="Padding" Value="0,0,12,12"/>
                                 <Setter Property="Background" Value="Transparent"/>
                             </Style>
                             <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                                 <Setter Property="Background" Value="Transparent"/>
                             </Style>
                             <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
                                 <Setter Property="Background" Value="Transparent"/>
                             </Style>
                         </ListBox.Styles>

                         <ListBox.ItemTemplate>
                             <DataTemplate x:DataType="models:Game">
                                 <Border Classes="GameGridCard"
                                         Background="{StaticResource BrBgCard}"
                                         BorderBrush="{StaticResource BrBorderSubtle}"
                                         BorderThickness="1"
                                         CornerRadius="{StaticResource RadiusLarge}"
                                         Width="205"
                                         Padding="0"
                                         PointerEntered="GameGridCard_PointerEntered"
                                         PointerExited="GameGridCard_PointerExited">
                                     <Border.Styles>
                                         <Style Selector="Border.GameGridCard:pointerover">
                                             <Setter Property="BorderBrush" Value="{StaticResource BrBorderDefault}"/>
                                             <Setter Property="Background" Value="{StaticResource BrBgElevated}"/>
                                             <Setter Property="RenderTransform" Value="scale(1.015)"/>
                                         </Style>
                                         <Style Selector="Border.GameGridCard">
                                             <Setter Property="RenderTransform" Value="scale(1)"/>
                                             <Setter Property="Transitions">
                                                 <Transitions>
                                                     <BrushTransition Property="Background" Duration="0:0:0.15"/>
                                                     <BrushTransition Property="BorderBrush" Duration="0:0:0.15"/>
                                                     <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18"/>
                                                 </Transitions>
                                             </Setter>
                                         </Style>
                                     </Border.Styles>

                                     <Grid Name="GridCardRoot">
                                         <StackPanel Spacing="10" Margin="8">
                                             <Border Height="280"
                                                     CornerRadius="{StaticResource RadiusMedium}"
                                                     ClipToBounds="True"
                                                     Background="{StaticResource BrBgElevated}"
                                                     BorderBrush="{StaticResource BrBorderSubtle}"
                                                     BorderThickness="1">
                                                 <Grid>
                                                     <TextBlock Text="🎮"
                                                                FontSize="40"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"
                                                                Foreground="{StaticResource BrTextSecondary}"
                                                                Opacity="0.5"/>
                                                     <Image Source="{Binding CoverImageUrl, Converter={StaticResource BitmapValueConverter}}"
                                                            Stretch="UniformToFill"/>

                                                     <Grid Margin="8,8,8,0" VerticalAlignment="Top">
                                                         <Grid.ColumnDefinitions>
                                                             <ColumnDefinition Width="*"/>
                                                             <ColumnDefinition Width="Auto"/>
                                                         </Grid.ColumnDefinitions>

                                                         <Border Grid.Column="0"
                                                                 Background="#BF10131A"
                                                                 BorderBrush="{StaticResource BrBorderSubtle}"
                                                                 BorderThickness="1"
                                                                 CornerRadius="6"
                                                                 Padding="8,3"
                                                                 HorizontalAlignment="Left">
                                                             <TextBlock Text="{Binding Platform}"
                                                                        FontSize="10"
                                                                        FontWeight="SemiBold"
                                                                        Foreground="{StaticResource BrTextPrimary}"/>
                                                         </Border>

                                                         <Button Grid.Column="1"
                                                                 Content="&#xE74D;"
                                                                 FontFamily="{StaticResource FontIcons}"
                                                                 Foreground="{StaticResource BrTextSecondary}"
                                                                 Background="#BF10131A"
                                                                 BorderBrush="{StaticResource BrBorderSubtle}"
                                                                 BorderThickness="1"
                                                                 FontSize="14"
                                                                 Width="26"
                                                                 Height="24"
                                                                 Padding="0"
                                                                 CornerRadius="6"
                                                                 ToolTip.Tip="{DynamicResource TxtRemoveGameTip}"
                                                                 IsVisible="{Binding IsManual, Converter={StaticResource BoolToVisibilityConverter}}"
                                                                 Click="BtnRemoveGame_Click"/>
                                                     </Grid>

                                                     <Border Background="#E61E1530"
                                                             BorderBrush="{StaticResource BrAccent}"
                                                             BorderThickness="1"
                                                             CornerRadius="6"
                                                             Padding="8,3"
                                                             Margin="8,0,8,8"
                                                             HorizontalAlignment="Left"
                                                             VerticalAlignment="Bottom"
                                                             IsVisible="{Binding IsOptiscalerInstalled, Converter={StaticResource BoolToVisibilityConverter}}">
                                                         <StackPanel Orientation="Horizontal">
                                                             <TextBlock Text="✦ OptiScaler"
                                                                        Foreground="{StaticResource BrAccent}"
                                                                        FontSize="{StaticResource FontSizeCaption}"
                                                                        FontWeight="Bold"/>
                                                             <TextBlock Text="{Binding OptiscalerVersion, StringFormat=' {0}'}"
                                                                        Foreground="{StaticResource BrAccent}"
                                                                        FontSize="{StaticResource FontSizeCaption}"
                                                                        FontWeight="SemiBold"
                                                                        IsVisible="{Binding OptiscalerVersion, Converter={StaticResource NullToVisibilityConverter}}"/>
                                                         </StackPanel>
                                                     </Border>
                                                 </Grid>
                                             </Border>

                                             <TextBlock Text="{Binding Name}"
                                                        MaxLines="2"
                                                        TextTrimming="CharacterEllipsis"
                                                        FontSize="{StaticResource FontSizeBody}"
                                                        FontWeight="SemiBold"
                                                        Foreground="{StaticResource BrTextPrimary}"/>

                                             <WrapPanel Orientation="Horizontal" ItemHeight="24" VerticalAlignment="Center">
                                                 <Border Background="#1A2E1A"
                                                         BorderBrush="#2D5A2D"
                                                         BorderThickness="1"
                                                         CornerRadius="6"
                                                         Padding="8,3"
                                                         Margin="0,0,6,0"
                                                         IsVisible="{Binding DlssVersion, Converter={StaticResource NullToVisibilityConverter}}">
                                                     <TextBlock Text="DLSS"
                                                                Foreground="#7FD481"
                                                                FontSize="{StaticResource FontSizeCaption}"
                                                                FontWeight="SemiBold"/>
                                                 </Border>
                                                 <Border Background="#2E1A1A"
                                                         BorderBrush="#5A2D2D"
                                                         BorderThickness="1"
                                                         CornerRadius="6"
                                                         Padding="8,3"
                                                         Margin="0,0,6,0"
                                                         IsVisible="{Binding FsrVersion, Converter={StaticResource NullToVisibilityConverter}}">
                                                     <TextBlock Text="FSR"
                                                                Foreground="#E07070"
                                                                FontSize="{StaticResource FontSizeCaption}"
                                                                FontWeight="SemiBold"/>
                                                 </Border>
                                                 <Border Background="#1A1E2E"
                                                         BorderBrush="#2D3A5A"
                                                         BorderThickness="1"
                                                         CornerRadius="6"
                                                         Padding="8,3"
                                                         Margin="0,0,6,0"
                                                         IsVisible="{Binding XessVersion, Converter={StaticResource NullToVisibilityConverter}}">
                                                     <TextBlock Text="XeSS"
                                                                Foreground="#7080E0"
                                                                FontSize="{StaticResource FontSizeCaption}"
                                                                FontWeight="SemiBold"/>
                                                 </Border>
                                             </WrapPanel>

                                         </StackPanel>

                                         <Border Name="GridCardHoverOverlay"
                                                 IsVisible="False"
                                                 Opacity="0"
                                                 IsHitTestVisible="False"
                                                 Background="#800B0E16"
                                                 CornerRadius="{StaticResource RadiusLarge}"/>

                                        <StackPanel Name="GridCardHoverActions"
                                                    IsVisible="False"
                                                    Opacity="0"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Spacing="10">
                                            <Button Name="BtnFastInstallGrid"
                                                    Classes="BtnBase"
                                                    MinWidth="128"
                                                    Padding="10,6"
                                                    HorizontalAlignment="Center"
                                                    HorizontalContentAlignment="Center"
                                                    Foreground="{StaticResource BrAccent}"
                                                    Content="{DynamicResource TxtQuickInstall}"
                                                    Click="BtnFastInstall_Click"
                                                    Loaded="BtnFastInstall_Loaded"/>
                                            <Button MinWidth="86"
                                                    HorizontalAlignment="Center"
                                                    HorizontalContentAlignment="Center"
                                                    Classes="BtnBase"
                                                    Padding="10,6"
                                                    Click="BtnManage_Click">
                                                <Button.Content>
                                                    <Grid ColumnDefinitions="Auto,*" VerticalAlignment="Center">
                                                        <TextBlock Grid.Column="0"
                                                                   Text="&#xF6AA;"
                                                                   FontFamily="{StaticResource FontIcons}"
                                                                   FontSize="14"
                                                                   Foreground="{StaticResource BrTextPrimary}"
                                                                   VerticalAlignment="Center"
                                                                   Margin="0,0,6,0"/>
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{DynamicResource TxtManageGame}"
                                                                   Foreground="{StaticResource BrTextPrimary}"
                                                                   VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Button.Content>
                                            </Button>
                                        </StackPanel>

                                        <!-- Edit mode overlay for grid card -->
                                        <Border Name="GridEditOverlayBorder"
                                                Classes="GridEditOverlay"
                                                Background="#660B0E16"
                                                CornerRadius="{StaticResource RadiusLarge}"
                                                Cursor="SizeAll"
                                                PointerPressed="DragHandle_PointerPressed">
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                                                <Border Background="{StaticResource BrBgElevated}"
                                                        Opacity="0.92"
                                                        BorderBrush="{StaticResource BrBorderSubtle}"
                                                        BorderThickness="1"
                                                        CornerRadius="8"
                                                        Padding="8"
                                                        Margin="0,0,0,0"
                                                        HorizontalAlignment="Center">
                                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="4">
                                                        <TextBlock Text="&#x283F;"
                                                                   FontSize="32"
                                                                   TextAlignment="Center"
                                                                   Foreground="{StaticResource BrTextSecondary}"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"/>
                                                        <TextBlock Text="{DynamicResource TxtDragToReorder}"
                                                                   FontSize="11"
                                                                   Foreground="{StaticResource BrTextSecondary}"
                                                                   HorizontalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                                <Button Classes="BtnBase"
                                                        Padding="12,5"
                                                        HorizontalAlignment="Center"
                                                        Click="BtnToggleHide_Click">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <TextBlock Name="TxtHideIconGrid"
                                                                   Text="&#xE5F2;"
                                                                   FontFamily="{StaticResource FontIcons}"
                                                                   FontSize="14"
                                                                   Foreground="{StaticResource BrTextSecondary}"
                                                                   VerticalAlignment="Center"/>
                                                        <TextBlock Name="TxtHideLabel"
                                                                   Text="{DynamicResource TxtHideGame}"
                                                                   Foreground="{StaticResource BrTextSecondary}"
                                                                   VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </Border>
                                     </Grid>
                                 </Border>
                             </DataTemplate>
                         </ListBox.ItemTemplate>
                     </ListBox>
                 </ScrollViewer>

                 <!-- Empty state: shown when scan returns no upscaler-compatible games -->
                 <Border Name="PnlNoUpscalersFound"
                         Grid.Row="3"
                         IsVisible="False"
                         VerticalAlignment="Center"
                         HorizontalAlignment="Center"
                         Margin="24">
                     <StackPanel Spacing="16" HorizontalAlignment="Center">
                         <TextBlock Text="&#xEEB9;"
                                    FontFamily="{StaticResource FontIcons}"
                                    FontSize="44"
                                    HorizontalAlignment="Center"
                                    Foreground="{StaticResource BrTextSecondary}"
                                    Opacity="0.4"/>
                         <TextBlock Text="{DynamicResource TxtNoUpscalersFoundTitle}"
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    HorizontalAlignment="Center"
                                    Foreground="{StaticResource BrTextPrimary}"/>
                         <TextBlock Text="{DynamicResource TxtNoUpscalersFoundHint}"
                                    TextWrapping="Wrap"
                                    MaxWidth="420"
                                    TextAlignment="Center"
                                    HorizontalAlignment="Center"
                                    Foreground="{StaticResource BrTextSecondary}"
                                    FontSize="{StaticResource FontSizeCaption}"/>
                     </StackPanel>
                 </Border>

                 <!-- Status Bar -->
                 <Border Grid.Row="4"
                         Background="{StaticResource BrBgDeep}"
                         BorderBrush="{StaticResource BrBorderSubtle}"
                         BorderThickness="0,1,0,0"
                         Padding="24,8">
                     <TextBlock Name="TxtStatus"
                                Text="{DynamicResource TxtStatusReady}"
                                FontSize="{StaticResource FontSizeCaption}"
                                Foreground="{StaticResource BrTextSecondary}"/>
                 </Border>

                 <!-- Ghost canvas: floating drag visuals sit here, above all content -->
                 <Canvas Name="DragGhostCanvas"
                         Grid.Row="0" Grid.RowSpan="5"
                         IsHitTestVisible="False"
                         ZIndex="100"/>

             </Grid> <!-- ViewGames -->

             <!-- ════════════════════════════════════════════════════════
                  2. PROFILES VIEW
                  ════════════════════════════════════════════════════════ -->
             <Grid Name="ViewProfiles" Opacity="0" IsHitTestVisible="False">
                 <Grid.Transitions>
                     <Transitions>
                         <DoubleTransition Property="Opacity" Duration="0:0:0.18" Easing="CubicEaseOut"/>
                     </Transitions>
                 </Grid.Transitions>
                 <Grid.RowDefinitions>
                     <RowDefinition Height="Auto"/>
                     <RowDefinition Height="*"/>
                 </Grid.RowDefinitions>

                 <!-- Header -->
                 <Border Grid.Row="0"
                         Background="{StaticResource BrBgDeep}"
                         BorderBrush="{StaticResource BrBorderSubtle}"
                         BorderThickness="0,0,0,1"
                         Padding="24,18">
                     <StackPanel VerticalAlignment="Center">
                         <TextBlock Text="{DynamicResource TxtProfViewTitle}"
                                    FontSize="20"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource BrTextPrimary}"/>
                         <TextBlock Text="{DynamicResource TxtProfViewDesc}"
                                    FontSize="12"
                                    Foreground="{StaticResource BrTextSecondary}"
                                    Margin="0,2,0,0"/>
                     </StackPanel>
                 </Border>

                 <!-- Content: action sidebar (left) + profile list (right) -->
                 <Grid Grid.Row="1" ColumnDefinitions="Auto, *">

                     <!-- Action sidebar -->
                     <Border Grid.Column="0"
                             Background="{StaticResource BrBgDeep}"
                             BorderBrush="{StaticResource BrBorderSubtle}"
                             BorderThickness="0,0,1,0"
                             Padding="16,24"
                             Width="230">
                         <StackPanel Spacing="8" VerticalAlignment="Top">
                             <Button Name="BtnNewProfileView"
                                     Content="{DynamicResource TxtBtnNewProfile}"
                                     Classes="BtnPrimary"
                                     HorizontalAlignment="Stretch"
                                     Padding="12,8"
                                     Click="BtnNewProfileView_Click"/>
                             <Button Name="BtnImportProfileView"
                                     Content="{DynamicResource TxtBtnImportIni}"
                                     Classes="BtnSecondary"
                                     HorizontalAlignment="Stretch"
                                     Padding="12,8"
                                     Click="BtnImportProfileView_Click"/>
                             <Border Height="1"
                                     Background="{StaticResource BrBorderSubtle}"
                                     Margin="0,4"/>
                             <Button Name="BtnSetDefaultView"
                                     Content="{DynamicResource TxtBtnSetDefault}"
                                     Classes="BtnSecondary"
                                     HorizontalAlignment="Stretch"
                                     Padding="12,8"
                                     IsEnabled="False"
                                     Click="BtnSetDefaultView_Click"/>
                             <Button Name="BtnEditProfileView"
                                     Content="{DynamicResource TxtBtnEdit}"
                                     Classes="BtnSecondary"
                                     HorizontalAlignment="Stretch"
                                     Padding="12,8"
                                     IsEnabled="False"
                                     Click="BtnEditProfileView_Click"/>
                             <Button Name="BtnDuplicateProfileView"
                                     Content="{DynamicResource TxtBtnDuplicate}"
                                     Classes="BtnSecondary"
                                     HorizontalAlignment="Stretch"
                                     Padding="12,8"
                                     IsEnabled="False"
                                     Click="BtnDuplicateProfileView_Click"/>
                             <Button Name="BtnExportProfileView"
                                     Content="{DynamicResource TxtBtnExportIni}"
                                     Classes="BtnSecondary"
                                     HorizontalAlignment="Stretch"
                                     Padding="12,8"
                                     IsEnabled="False"
                                     Click="BtnExportProfileView_Click"/>
                             <Button Name="BtnDeleteProfileView"
                                     Content="{DynamicResource TxtDeletePlain}"
                                     Classes="BtnSecondary"
                                     HorizontalAlignment="Stretch"
                                     Padding="12,8"
                                     IsEnabled="False"
                                     Click="BtnDeleteProfileView_Click"/>
                             <Border Height="1"
                                     Background="{StaticResource BrBorderSubtle}"
                                     Margin="0,4"/>
                             <TextBlock Name="TxtProfileInfoView"
                                        FontSize="11"
                                        Foreground="{StaticResource BrTextSecondary}"
                                        TextWrapping="Wrap"/>
                         </StackPanel>
                     </Border>

                     <!-- Profile list -->
                     <Grid Grid.Column="1" RowDefinitions="Auto, *">
                         <Border Grid.Row="0" Padding="24,16,24,0">
                             <TextBox Name="TxtProfileSearchView"
                                      Watermark="{DynamicResource TxtSearchProfiles}"
                                      Classes="Input"
                                      Background="{StaticResource BrBgDeep}"
                                      BorderBrush="{StaticResource BrBorderSubtle}"
                                      TextChanged="TxtProfileSearchView_TextChanged"/>
                         </Border>

                         <ScrollViewer Grid.Row="1" Padding="0" Margin="0,8,0,0">
                             <StackPanel Name="PnlProfilesView" Spacing="8" Margin="24,8,24,24"/>
                         </ScrollViewer>
                     </Grid>
                 </Grid>
             </Grid> <!-- ViewProfiles -->

             <!-- ══ 3. PROFILE EDITOR VIEW ══════════════════════════════════════════════ -->
             <Grid Name="ViewProfileEditor" Opacity="0" IsHitTestVisible="False">
                 <Grid.Transitions>
                     <Transitions>
                         <DoubleTransition Property="Opacity" Duration="0:0:0.18" Easing="CubicEaseOut"/>
                     </Transitions>
                 </Grid.Transitions>
                 <Grid.RowDefinitions>
                     <RowDefinition Height="Auto"/>
                     <RowDefinition Height="*"/>
                     <RowDefinition Height="Auto"/>
                 </Grid.RowDefinitions>

                 <!-- Header -->
                 <Border Grid.Row="0"
                         Background="{StaticResource BrBgDeep}"
                         BorderBrush="{StaticResource BrBorderSubtle}"
                         BorderThickness="0,0,0,1"
                         Padding="16,14">
                     <Grid ColumnDefinitions="Auto, *">
                         <Button Grid.Column="0"
                                 Name="BtnEditorBack"
                                 Content="{DynamicResource TxtEditorBackBtn}"
                                 Classes="BtnSecondary"
                                 Padding="12,8"
                                 VerticalAlignment="Center"
                                 Click="BtnEditorBack_Click"/>
                         <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0">
                             <TextBlock Name="TxtEditorTitle"
                                        Text="{DynamicResource TxtEditorTitle}"
                                        FontSize="18"
                                        FontWeight="Bold"
                                        Foreground="{StaticResource BrTextPrimary}"/>
                             <TextBlock Text="{DynamicResource TxtEditorDesc}"
                                        FontSize="11"
                                        Foreground="{StaticResource BrTextSecondary}"
                                        Margin="0,2,0,0"/>
                         </StackPanel>
                     </Grid>
                 </Border>

                 <!-- Sidebar + Settings -->
                 <Grid Grid.Row="1" ColumnDefinitions="Auto, *">

                     <!-- Left sidebar: name, description, section nav -->
                     <Border Grid.Column="0"
                             Background="{StaticResource BrBgDeep}"
                             BorderBrush="{StaticResource BrBorderSubtle}"
                             BorderThickness="0,0,1,0"
                             Padding="12,20,12,20"
                             MinWidth="300"
                             MaxWidth="360">
                         <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="12">
                             <StackPanel Grid.Row="0">
                                 <TextBlock Text="{DynamicResource TxtEditorNameLabel}"
                                            Foreground="{StaticResource BrTextSecondary}"
                                            FontSize="12"
                                            Margin="0,0,0,4"/>
                                 <TextBox Name="TxtProfileNameEd"
                                          Watermark="{DynamicResource TxtEditorNameWatermark}"
                                          Height="32"/>
                             </StackPanel>

                             <StackPanel Grid.Row="1" Spacing="8">
                                 <StackPanel>
                                     <TextBlock Text="{DynamicResource TxtEditorDescLabel}"
                                                Foreground="{StaticResource BrTextSecondary}"
                                                FontSize="12"
                                                Margin="0,0,0,4"/>
                                     <TextBox Name="TxtDescriptionEd"
                                              Watermark="{DynamicResource TxtEditorDescWatermark}"
                                              Height="32"/>
                                 </StackPanel>

                                 <StackPanel Spacing="4">
                                     <TextBlock Text="{DynamicResource TxtEditorModeLabel}"
                                                Foreground="{StaticResource BrTextSecondary}"
                                                FontSize="12"
                                                FontWeight="Bold"
                                                Margin="0,0,0,4"/>
                                     <Grid ColumnDefinitions="*,*">
                                         <Button Name="BtnEasyModeEd"
                                                 Grid.Column="0"
                                                 HorizontalAlignment="Stretch"
                                                 HorizontalContentAlignment="Center"
                                                 Padding="12,8"
                                                 FontSize="12"
                                                 Classes="BtnPrimary"
                                                 Content="{DynamicResource TxtEditorModeEasy}"
                                                 Click="BtnEasyModeEd_Click"
                                                 Margin="0,0,2,0"/>
                                         <Button Name="BtnAdvancedModeEd"
                                                 Grid.Column="1"
                                                 HorizontalAlignment="Stretch"
                                                 HorizontalContentAlignment="Center"
                                                 Padding="12,8"
                                                 FontSize="12"
                                                 Classes="BtnSecondary"
                                                 Content="{DynamicResource TxtEditorModeAdvanced}"
                                                 Click="BtnAdvancedModeEd_Click"
                                                 Margin="2,0,0,0"/>
                                     </Grid>
                                 </StackPanel>
                             </StackPanel>

                             <Border Grid.Row="2"
                                     Height="1"
                                     Background="{StaticResource BrBorderSubtle}"/>

                             <ScrollViewer Grid.Row="3"
                                           Margin="0,8,0,0"
                                           VerticalScrollBarVisibility="Auto"
                                           HorizontalScrollBarVisibility="Disabled">
                                 <StackPanel Name="SidebarNavEd" Spacing="8">
                                     <TextBlock Text="{DynamicResource TxtEditorNavLabel}"
                                                FontSize="12"
                                                FontWeight="Bold"
                                                Foreground="{StaticResource BrTextSecondary}"
                                                Margin="0,0,0,8"/>
                                 </StackPanel>
                             </ScrollViewer>
                         </Grid>
                     </Border>

                     <!-- Right: search + settings wrap -->
                     <Grid Grid.Column="1" RowDefinitions="Auto, *">
                         <StackPanel Grid.Row="0" Margin="24,12,24,0">
                             <TextBox Name="TxtSettingsSearchEd"
                                      Watermark="{DynamicResource TxtEditorSearchWm}"
                                      Classes="Input"
                                      Background="{StaticResource BrBgDeep}"
                                      BorderBrush="{StaticResource BrBorderSubtle}"
                                      TextChanged="TxtSettingsSearchEd_TextChanged"/>
                         </StackPanel>

                         <ScrollViewer Grid.Row="1"
                                       Name="SettingsScrollViewerEd"
                                       Padding="0"
                                       Margin="24,16,24,20">
                             <WrapPanel Name="SectionsWrapEd"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Top"/>
                         </ScrollViewer>
                     </Grid>
                 </Grid>

                 <!-- Footer -->
                 <Border Grid.Row="2"
                         Padding="24,18"
                         Background="{StaticResource BrBgDeep}"
                         BorderBrush="{StaticResource BrBorderSubtle}"
                         BorderThickness="0,1,0,0">
                     <Grid ColumnDefinitions="*, Auto">
                         <TextBlock Grid.Column="0"
                                    VerticalAlignment="Center"
                                    FontSize="11"
                                    Foreground="{StaticResource BrTextSecondary}"
                                    Text="{DynamicResource TxtEditorFooterNote}"/>
                         <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                             <Button Content="{DynamicResource TxtEditorCancel}"
                                     Classes="BtnSecondary"
                                     Padding="16,8"
                                     Click="BtnEditorBack_Click"/>
                             <Button Name="BtnEditorSave"
                                     Content="{DynamicResource TxtEditorSave}"
                                     Classes="BtnPrimary"
                                     Padding="20,8"
                                     Click="BtnEditorSave_Click"/>
                         </StackPanel>
                     </Grid>
                 </Border>
             </Grid> <!-- ViewProfileEditor -->

             <!-- ════════════════════════════════════════════════════════
                  3. SETTINGS VIEW
                  ════════════════════════════════════════════════════════ -->
             <Grid Name="ViewSettings" Opacity="0" IsHitTestVisible="False">
                 <Grid.Transitions>
                     <Transitions>
                         <DoubleTransition Property="Opacity" Duration="0:0:0.18" Easing="CubicEaseOut"/>
                     </Transitions>
                 </Grid.Transitions>
                 <Grid.RowDefinitions>
                     <RowDefinition Height="Auto"/>
                     <RowDefinition Height="*"/>
                 </Grid.RowDefinitions>

                 <Border Grid.Row="0" Background="{StaticResource BrBgDeep}" BorderBrush="{StaticResource BrBorderSubtle}" BorderThickness="0,0,0,1" Padding="24,18">
                     <StackPanel>
                         <TextBlock Text="{DynamicResource TxtSettingsTitle}" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource BrTextPrimary}"/>
                     </StackPanel>
                 </Border>

                 <ScrollViewer Grid.Row="1"
                               VerticalScrollBarVisibility="Auto"
                               Margin="0"
                               Background="Transparent"
                               PointerPressed="SettingsBackground_PointerPressed">
                    <StackPanel Margin="24">
                        <TextBlock Text="{DynamicResource TxtAppPrefs}"
                                   Foreground="{StaticResource BrTextSecondary}"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,12"/>

                        <WrapPanel Name="SettingsWrap" Orientation="Horizontal" HorizontalAlignment="Stretch" Margin="0" VerticalAlignment="Top"
                                   SizeChanged="SettingsWrap_SizeChanged">
                            <!-- Language -->
                            <Border Background="{StaticResource BrBgCard}"
                                    BorderBrush="{StaticResource BrBorderSubtle}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource RadiusLarge}"
                                    Padding="20,16"
                                    Margin="0,0,16,16"
                                    HorizontalAlignment="Left">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource TxtLanguage}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource BrTextPrimary}"/>
                                        <TextBlock Text="{DynamicResource TxtLanguageDesc}"
                                                   Foreground="{StaticResource BrTextSecondary}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,4,16,0"
                                                   FontSize="{StaticResource FontSizeCaption}"/>
                                    </StackPanel>
                                    <ComboBox Name="CmbLanguage"
                                              Grid.Column="1"
                                              Width="160"
                                              VerticalAlignment="Center"
                                              SelectionChanged="CmbLanguage_SelectionChanged">
                                        <ComboBoxItem Tag="en" Content="English"/>
                                        <ComboBoxItem Tag="es" Content="Español"/>
                                        <ComboBoxItem Tag="pt-BR" Content="Português (Brasil)"/>
                                        <ComboBoxItem Tag="fr" Content="Français"/>
                                        <ComboBoxItem Tag="it" Content="Italiano"/>
                                        <ComboBoxItem Tag="ru" Content="Русский"/>
                                        <ComboBoxItem Tag="de" Content="Deutsch"/>
                                        <ComboBoxItem Tag="ja" Content="日本語"/>
                                        <ComboBoxItem Tag="zh-CN" Content="简体中文"/>
                                        <ComboBoxItem Tag="zh-TW" Content="繁體中文"/>
                                        <ComboBoxItem Tag="ko" Content="한국어"/>
                                        <ComboBoxItem Tag="pl" Content="Polski"/>
                                        <ComboBoxItem Tag="tr" Content="Türkçe"/>
                                        <ComboBoxItem Tag="nl" Content="Nederlands"/>
                                    </ComboBox>
                                </Grid>
                            </Border>

                            <!-- Cache Management -->
                            <Border Background="{StaticResource BrBgCard}"
                                    BorderBrush="{StaticResource BrBorderSubtle}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource RadiusLarge}"
                                    Padding="20,16"
                                    Margin="0,0,16,16"
                                    HorizontalAlignment="Left">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource TxtCacheMgmt}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource BrTextPrimary}"/>
                                        <TextBlock Text="{DynamicResource TxtCacheDesc}"
                                                   Foreground="{StaticResource BrTextSecondary}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,4,16,0"
                                                   FontSize="{StaticResource FontSizeCaption}"/>
                                    </StackPanel>
                                    <Button Name="BtnManageCache"
                                            Grid.Column="1"
                                            Classes="BtnBase"
                                            Padding="16,8"
                                            VerticalAlignment="Center"
                                            Click="BtnManageCache_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <TextBlock Text="&#xF419;"
                                                       FontFamily="{StaticResource FontIcons}"
                                                       FontSize="14"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Text="Manage"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- Scan Sources -->
                            <Border Background="{StaticResource BrBgCard}"
                                    BorderBrush="{StaticResource BrBorderSubtle}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource RadiusLarge}"
                                    Padding="20,16"
                                    Margin="0,0,16,16"
                                    HorizontalAlignment="Left">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource TxtScanSources}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource BrTextPrimary}"/>
                                        <TextBlock Text="{DynamicResource TxtScanSourcesDesc}"
                                                   Foreground="{StaticResource BrTextSecondary}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,4,16,0"
                                                   FontSize="{StaticResource FontSizeCaption}"/>
                                    </StackPanel>
                                    <Button Name="BtnManageScanSources"
                                            Grid.Column="1"
                                            Classes="BtnBase"
                                            Padding="16,8"
                                            VerticalAlignment="Center"
                                            Click="BtnManageScanSources_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <TextBlock Text="&#xF419;"
                                                       FontFamily="{StaticResource FontIcons}"
                                                       FontSize="14"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Text="Manage"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- Default GPU -->
                            <Border Background="{StaticResource BrBgCard}"
                                    BorderBrush="{StaticResource BrBorderSubtle}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource RadiusLarge}"
                                    Padding="20,16"
                                    Margin="0,0,16,16"
                                    HorizontalAlignment="Left">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource TxtDefaultGpuTitle}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource BrTextPrimary}"/>
                                        <TextBlock Text="{DynamicResource TxtDefaultGpuDesc}"
                                                   Foreground="{StaticResource BrTextSecondary}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,4,16,0"
                                                   FontSize="{StaticResource FontSizeCaption}"/>
                                    </StackPanel>
                                    <ComboBox Name="CmbDefaultGpu"
                                              Grid.Column="1"
                                              Width="240"
                                              VerticalAlignment="Center"
                                              SelectionChanged="CmbDefaultGpu_SelectionChanged"/>
                                </Grid>
                            </Border>

                            <!-- Auto Scan -->
                            <Border Classes="InteractiveOption CardOption"
                                    CornerRadius="{StaticResource RadiusLarge}"
                                    Padding="20,16"
                                    Margin="0,0,16,16"
                                    HorizontalAlignment="Left">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource TxtAutoScan}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource BrTextPrimary}"/>
                                        <TextBlock Text="{DynamicResource TxtAutoScanDesc}"
                                                   Foreground="{StaticResource BrTextSecondary}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,4,16,0"
                                                   FontSize="{StaticResource FontSizeCaption}"/>
                                    </StackPanel>
                                    <ToggleSwitch Name="TglAutoScan"
                                                  Grid.Column="1"
                                                  VerticalAlignment="Center"
                                                  OnContent="" OffContent=""
                                                  IsChecked="True"
                                                  Focusable="False"
                                                  IsCheckedChanged="TglAutoScan_IsCheckedChanged"/>
                                </Grid>
                            </Border>

                            <!-- Animations -->
                            <Border Classes="InteractiveOption CardOption"
                                    CornerRadius="{StaticResource RadiusLarge}"
                                    Padding="20,16"
                                    Margin="0,0,16,16"
                                    HorizontalAlignment="Left">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource TxtAnimations}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource BrTextPrimary}"/>
                                        <TextBlock Text="{DynamicResource TxtAnimationsDesc}"
                                                   Foreground="{StaticResource BrTextSecondary}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,4,16,0"
                                                   FontSize="{StaticResource FontSizeCaption}"/>
                                    </StackPanel>
                                    <ToggleSwitch Name="TglAnimations"
                                                  Grid.Column="1"
                                                  VerticalAlignment="Center"
                                                  OnContent="" OffContent=""
                                                  IsChecked="True"
                                                  Focusable="False"
                                                  IsCheckedChanged="TglAnimations_IsCheckedChanged"/>
                                </Grid>
                            </Border>

                            <!-- Clear Application Cache -->
                            <Border Background="{StaticResource BrBgCard}"
                                    BorderBrush="{StaticResource BrBorderSubtle}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource RadiusLarge}"
                                    Padding="20,16"
                                    Margin="0,0,16,16"
                                    HorizontalAlignment="Left">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource TxtClearAppCacheTitle}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource BrTextPrimary}"/>
                                        <TextBlock Text="{DynamicResource TxtClearAppCacheDesc}"
                                                   Foreground="{StaticResource BrTextSecondary}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,4,16,0"
                                                   FontSize="{StaticResource FontSizeCaption}"/>
                                    </StackPanel>
                                    <Button Name="BtnClearAppCache"
                                            Grid.Column="1"
                                            Content="{DynamicResource TxtClearCacheBtn}"
                                            Classes="BtnBase"
                                            Padding="16,8"
                                            VerticalAlignment="Center"
                                            Click="BtnClearAppCache_Click"/>
                                </Grid>
                            </Border>

                            <!-- SteamGridDB API Key -->
                            <Border Background="{StaticResource BrBgCard}"
                                    BorderBrush="{StaticResource BrBorderSubtle}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource RadiusLarge}"
                                    Padding="20,16"
                                    Margin="0,0,16,16"
                                    HorizontalAlignment="Left">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource TxtSteamGridApiKey}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource BrTextPrimary}"/>
                                        <TextBlock Text="{DynamicResource TxtSteamGridApiKeyDesc}"
                                                   Foreground="{StaticResource BrTextSecondary}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,4,16,0"
                                                   FontSize="{StaticResource FontSizeCaption}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                                        <TextBox Name="TxtSteamGridApiKey"
                                                 Width="300"
                                                 Watermark="{DynamicResource TxtSteamGridApiKeyPlaceholder}"
                                                 LostFocus="TxtSteamGridApiKey_LostFocus"/>
                                        <Button Name="BtnSteamGridApiGuide"
                                                Content="{DynamicResource TxtSteamGridGetApiKey}"
                                                Classes="BtnBase"
                                                HorizontalAlignment="Right"
                                                Padding="12,6"
                                                Click="BtnSteamGridApiGuide_Click"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Network / Proxy -->
                            <Border Background="{StaticResource BrBgCard}"
                                    BorderBrush="{StaticResource BrBorderSubtle}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource RadiusLarge}"
                                    Padding="20,16"
                                    Margin="0,0,16,16"
                                    HorizontalAlignment="Left">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource TxtNetworkTitle}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource BrTextPrimary}"/>
                                        <TextBlock Text="{DynamicResource TxtNetworkDesc}"
                                                   Foreground="{StaticResource BrTextSecondary}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,4,16,0"
                                                   FontSize="{StaticResource FontSizeCaption}"/>
                                    </StackPanel>
                                    <Button Name="BtnManageProxy"
                                            Grid.Column="1"
                                            Classes="BtnBase"
                                            Padding="16,8"
                                            VerticalAlignment="Center"
                                            Click="BtnManageProxy_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <TextBlock Text="&#xF419;"
                                                       FontFamily="{StaticResource FontIcons}"
                                                       FontSize="14"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Text="Manage"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>
                        </WrapPanel>
                    </StackPanel>
                 </ScrollViewer>
             </Grid>

             <!-- ════════════════════════════════════════════════════════
                  3. HELP / COMPONENT INFO VIEW
                  ════════════════════════════════════════════════════════ -->
             <Grid Name="ViewHelp" Opacity="0" IsHitTestVisible="False">
                 <Grid.Transitions>
                     <Transitions>
                         <DoubleTransition Property="Opacity" Duration="0:0:0.18" Easing="CubicEaseOut"/>
                     </Transitions>
                 </Grid.Transitions>
                 <Grid.RowDefinitions>
                     <RowDefinition Height="Auto"/>
                     <RowDefinition Height="*"/>
                 </Grid.RowDefinitions>

                 <!-- Header -->
                <Border Grid.Row="0" Background="{StaticResource BrBgDeep}" BorderBrush="{StaticResource BrBorderSubtle}" BorderThickness="0,0,0,1" Padding="24,18">
                    <Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource TxtHelpTitle}"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource BrTextPrimary}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                 <!-- Sidebar + content -->
                 <Grid Grid.Row="1" ColumnDefinitions="270,*">

                     <!-- SIDEBAR -->
                     <Border Grid.Column="0"
                             Background="{StaticResource BrBgDeep}"
                             BorderBrush="{StaticResource BrBorderSubtle}"
                             BorderThickness="0,0,1,0">
                         <ScrollViewer VerticalScrollBarVisibility="Auto">
                             <StackPanel Name="HelpPagesSidebar" Margin="8,12,8,12" Spacing="2"/>
                         </ScrollViewer>
                     </Border>

                     <!-- CONTENT AREA -->
                     <ScrollViewer Grid.Column="1"
                                   Name="HelpContentScrollViewer"
                                   VerticalScrollBarVisibility="Auto">
                         <StackPanel Name="HelpContentArea" MaxWidth="700" Margin="32,24,32,48">
                             <!-- Dynamic content will be loaded here -->
                         </StackPanel>
                     </ScrollViewer>
                 </Grid>
             </Grid>

             <!-- SCANNING MODAL OVERLAY (Sits on top of EVERYTHING in column 1) -->
             <Grid Name="OverlayScanning" Background="#B2000000" IsVisible="False" ZIndex="100">
                <Border Background="{StaticResource BrBgElevated}"
                        BorderBrush="{StaticResource BrAccent}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource RadiusLarge}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Padding="60,50">
                    <StackPanel>
                        <!-- Animated Dots -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,24">
                            <Ellipse Name="ScanDot1" Width="12" Height="12" Fill="{StaticResource BrAccent}" Margin="4,12,4,0"/>
                            <Ellipse Name="ScanDot2" Width="12" Height="12" Fill="{StaticResource BrAccent}" Margin="4,12,4,0"/>
                            <Ellipse Name="ScanDot3" Width="12" Height="12" Fill="{StaticResource BrAccent}" Margin="4,12,4,0"/>
                        </StackPanel>
                        <TextBlock Text="{DynamicResource TxtScanningTitle}"
                                   FontSize="{StaticResource FontSizeSubtitle}"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource BrTextPrimary}"
                                   HorizontalAlignment="Center"
                                   Margin="0,16,0,8"/>
                        <TextBlock Text="{DynamicResource TxtScanningDesc}"
                                   FontSize="{StaticResource FontSizeBody}"
                                   Foreground="{StaticResource BrTextSecondary}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
             </Grid>

             <!-- TOAST NOTIFICATION -->
             <Border Name="BdToast"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Bottom"
                     Margin="0,0,0,24"
                     Background="{StaticResource BrBgElevated}"
                     BorderBrush="{StaticResource BrAccent}"
                     BorderThickness="1"
                     CornerRadius="{StaticResource RadiusMedium}"
                     Padding="14,10"
                     IsVisible="False"
                     ZIndex="200">
                 <StackPanel>
                     <StackPanel Orientation="Horizontal">
                         <TextBlock Name="TxtToastIcon"
                                    Text="..."
                                    Foreground="{StaticResource BrAccent}"
                                    FontWeight="Bold"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center"/>
                         <TextBlock Name="TxtToastMessage"
                                    Text="Working..."
                                    Foreground="{StaticResource BrTextPrimary}"
                                    VerticalAlignment="Center"/>
                     </StackPanel>
                     <ProgressBar Name="PrgToast"
                                  Height="6"
                                  Width="240"
                                  Margin="0,8,0,0"
                                  IsVisible="False"
                                  IsIndeterminate="True"
                                  Minimum="0"
                                  Maximum="100"/>
                 </StackPanel>
             </Border>

             <!-- SECONDARY TOAST (non-blocking notice) -->
             <Border Name="BdToastSecondary"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Bottom"
                     Margin="0,0,0,100"
                     Background="{StaticResource BrBgElevated}"
                     BorderBrush="{StaticResource BrBorderSubtle}"
                     BorderThickness="1"
                     CornerRadius="{StaticResource RadiusMedium}"
                     Padding="12,8"
                     IsVisible="False"
                     ZIndex="210">
                 <StackPanel Orientation="Horizontal">
                     <TextBlock Text="i"
                                Foreground="{StaticResource BrTextSecondary}"
                                FontWeight="Bold"
                                Margin="0,0,8,0"
                                VerticalAlignment="Center"/>
                     <TextBlock Name="TxtToastSecondaryMessage"
                                Text="Info"
                                Foreground="{StaticResource BrTextPrimary}"
                                VerticalAlignment="Center"/>
                 </StackPanel>
             </Border>

        </Grid>

        <!-- LOADING RESOURCES OVERLAY (covers full window while version data is being fetched) -->
        <Grid Name="OverlayLoading" Grid.ColumnSpan="2" Background="#CC000000" IsVisible="False" ZIndex="500">
            <Border Background="{StaticResource BrBgElevated}"
                    BorderBrush="{StaticResource BrAccent}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusLarge}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="60,50">
                <StackPanel HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,24">
                        <Ellipse Name="LoadDot1" Width="12" Height="12" Fill="{StaticResource BrAccent}" Margin="4,12,4,0"/>
                        <Ellipse Name="LoadDot2" Width="12" Height="12" Fill="{StaticResource BrAccent}" Margin="4,12,4,0"/>
                        <Ellipse Name="LoadDot3" Width="12" Height="12" Fill="{StaticResource BrAccent}" Margin="4,12,4,0"/>
                    </StackPanel>
                    <TextBlock Text="{DynamicResource TxtLoadingResources}"
                               FontSize="{StaticResource FontSizeSubtitle}"
                               FontWeight="Bold"
                               Foreground="{StaticResource BrTextPrimary}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,8"/>
                    <TextBlock Text="{DynamicResource TxtLoadingResourcesDesc}"
                               FontSize="{StaticResource FontSizeBody}"
                               Foreground="{StaticResource BrTextSecondary}"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- VIRTUAL KEYBOARD OVERLAY -->
        <Border Name="VirtualKeyboardOverlay"
                Grid.ColumnSpan="2"
                Background="#C0000000"
                IsVisible="False"
                ZIndex="9998">
            <Border Background="{StaticResource BrBgElevated}"
                    CornerRadius="16"
                    BorderThickness="1"
                    BorderBrush="{StaticResource BrBorder}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="24"
                    BoxShadow="0 16 64 0 #C0000000">
                <StackPanel Spacing="16">
                    <TextBlock Text="VIRTUAL KEYBOARD"
                               FontFamily="{StaticResource FontPrimary}"
                               Foreground="{StaticResource BrTextSecondary}"
                               FontSize="14"
                               FontWeight="Bold"
                               LetterSpacing="3"
                               HorizontalAlignment="Center"/>
                    <Border Background="{StaticResource BrBgBase}"
                            CornerRadius="8"
                            BorderThickness="1"
                            BorderBrush="{StaticResource BrBorder}"
                            Padding="12,8"
                            Margin="0,0,0,8"
                            Height="40">
                        <TextBlock Name="TxtOskPreview"
                                   Text=""
                                   Foreground="{StaticResource BrTextPrimary}"
                                   FontSize="16"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Left"/>
                    </Border>

                    <UniformGrid Name="OskGrid" Columns="10" Rows="4">
                        <!-- Populated in code-behind -->
                    </UniformGrid>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="32" Margin="0,16,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Border Background="{StaticResource BrAccent}" CornerRadius="12" Width="24" Height="24">
                                <TextBlock Text="A" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/>
                            </Border>
                            <TextBlock Text="Select" Foreground="{StaticResource BrTextPrimary}" VerticalAlignment="Center" FontSize="14"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Border Background="#E05252" CornerRadius="12" Width="24" Height="24">
                                <TextBlock Text="B" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/>
                            </Border>
                            <TextBlock Text="Close" Foreground="{StaticResource BrTextPrimary}" VerticalAlignment="Center" FontSize="14"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Border Background="#4DA6FF" CornerRadius="12" Width="24" Height="24">
                                <TextBlock Text="X" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/>
                            </Border>
                            <TextBlock Text="Backspace" Foreground="{StaticResource BrTextPrimary}" VerticalAlignment="Center" FontSize="14"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Border Background="#FFB347" CornerRadius="12" Width="24" Height="24">
                                <TextBlock Text="Y" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/>
                            </Border>
                            <TextBlock Text="Space" Foreground="{StaticResource BrTextPrimary}" VerticalAlignment="Center" FontSize="14"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- Dim backdrop shown behind child dialogs -->
        <Border Name="DimOverlay"
                Grid.ColumnSpan="2"
                Background="#A0000000"
                IsVisible="False"
                ZIndex="9999"/>
    </Grid>
</Window>
