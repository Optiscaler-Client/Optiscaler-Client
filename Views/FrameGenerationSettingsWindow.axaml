<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="OptiscalerClient.Views.FrameGenerationSettingsWindow"
        Title="Frame Generation"
        Width="470"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        SystemDecorations="None"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        CanResize="False"
        ShowInTaskbar="False">

    <Window.Styles>
        <Style Selector=":is(Control)">
            <Setter Property="FocusAdorner" Value="{x:Null}"/>
        </Style>
    </Window.Styles>

    <Panel Name="RootPanel" Margin="16" Opacity="0">
        <Border Background="{StaticResource BrBgBase}"
                BorderBrush="{StaticResource BrBorderSubtle}"
                BorderThickness="1"
                CornerRadius="12"
                BoxShadow="0 10 30 0 #A0000000">
            <Grid RowDefinitions="Auto,Auto,Auto">
                <Border Name="TitleBar"
                        Grid.Row="0"
                        Background="{StaticResource BrBgDeep}"
                        BorderBrush="{StaticResource BrBorderSubtle}"
                        BorderThickness="0,0,0,1"
                        CornerRadius="12,12,0,0"
                        Padding="22,16">
                    <TextBlock Text="{DynamicResource TxtFrameGeneration}"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="{StaticResource BrTextPrimary}"/>
                </Border>

                <StackPanel Grid.Row="1" Margin="22,18" Spacing="13">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{DynamicResource TxtFgRoute}"
                                   Foreground="{StaticResource BrTextSecondary}"
                                   FontSize="{StaticResource FontSizeCaption}"/>
                        <ComboBox Name="CmbFgRoute"
                                  HorizontalAlignment="Stretch"
                                  Classes="BtnSelector"
                                  HorizontalContentAlignment="Left"
                                  SelectionChanged="CmbFgRoute_SelectionChanged"/>
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="{DynamicResource TxtFgOutput}"
                                   Foreground="{StaticResource BrTextSecondary}"
                                   FontSize="{StaticResource FontSizeCaption}"/>
                        <ComboBox Name="CmbFgOutput"
                                  HorizontalAlignment="Stretch"
                                  Classes="BtnSelector"
                                  HorizontalContentAlignment="Left"
                                  SelectionChanged="CmbFgOutput_SelectionChanged"/>
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="{DynamicResource TxtMfgMultiplier}"
                                   Foreground="{StaticResource BrTextSecondary}"
                                   FontSize="{StaticResource FontSizeCaption}"/>
                        <ComboBox Name="CmbMfgMultiplier"
                                  HorizontalAlignment="Stretch"
                                  Classes="BtnSelector"
                                  HorizontalContentAlignment="Left"/>
                    </StackPanel>

                    <CheckBox Name="ChkAdvancedRoutes"
                              Content="{DynamicResource TxtFgAdvancedRoutes}"
                              IsCheckedChanged="ChkAdvancedRoutes_IsCheckedChanged"/>
                </StackPanel>

                <Border Grid.Row="2"
                        Background="{StaticResource BrBgDeep}"
                        BorderBrush="{StaticResource BrBorderSubtle}"
                        BorderThickness="0,1,0,0"
                        CornerRadius="0,0,12,12"
                        Padding="22,13">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                        <Button Content="{DynamicResource TxtCancel}"
                                Classes="BtnBase"
                                Padding="16,8"
                                Click="BtnCancel_Click"/>
                        <Button Content="{DynamicResource TxtSave}"
                                Classes="BtnPrimary"
                                Padding="16,8"
                                Click="BtnSave_Click"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Panel>
</Window>
