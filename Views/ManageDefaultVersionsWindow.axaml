<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="OptiscalerClient.Views.ManageDefaultVersionsWindow"
        Title="Default Versions &amp; Quick Install Settings"
        Width="1000"
        MinHeight="400"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        SystemDecorations="None"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        CanResize="False"
        ShowInTaskbar="False">

    <Window.Styles>
        <Style Selector="Button.InvisibleBtn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style Selector="Button.InvisibleBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="Button.InvisibleBtn:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </Window.Styles>

    <Panel Margin="16" Name="RootPanel" Opacity="0">
        <Border CornerRadius="12"
                Background="{StaticResource BrBgBase}"
                BoxShadow="0 10 30 0 #A0000000">

            <Grid>
                <Border CornerRadius="12"
                        BorderBrush="{StaticResource BrBorderSubtle}"
                        BorderThickness="1"
                        ZIndex="10"
                        IsHitTestVisible="False"/>

                <Border CornerRadius="12"
                        Background="Transparent"
                        ClipToBounds="True">

                    <Grid RowDefinitions="Auto, *, Auto">

                        <!-- Title Bar -->
                        <Border Grid.Row="0"
                                Name="TitleBar"
                                Background="{StaticResource BrBgDeep}"
                                Padding="24,18"
                                BorderBrush="{StaticResource BrBorderSubtle}"
                                BorderThickness="0,0,0,1">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource TxtManageDefaultVersions}"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource BrTextPrimary}"/>
                                <TextBlock Text="{DynamicResource TxtManageDefaultVersionsDesc}"
                                           FontSize="{StaticResource FontSizeCaption}"
                                           Foreground="{StaticResource BrTextSecondary}"
                                           TextWrapping="Wrap"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Content -->
                        <ScrollViewer Name="MainScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <Grid Margin="24,20" ColumnDefinitions="*,*,*" RowSpacing="20" ColumnSpacing="16">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Row 0, Col 0 : OptiScaler version -->
                                <StackPanel Grid.Row="0" Grid.Column="0" Spacing="6">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="{DynamicResource TxtOptiScalerLbl}"
                                                   FontWeight="SemiBold"
                                                   FontSize="14"
                                                   Foreground="{StaticResource BrTextPrimary}"
                                                   VerticalAlignment="Center"/>
                                        <Border Background="{StaticResource BrBgElevated}"
                                                BorderBrush="{StaticResource BrBorderSubtle}"
                                                BorderThickness="1" CornerRadius="8"
                                                Width="16" Height="16"
                                                ToolTip.ShowDelay="100" Cursor="Help"
                                                ToolTip.Tip="{DynamicResource TxtDefaultOptiVersionDesc}">
                                            <TextBlock Text="?" Foreground="{StaticResource BrTextSecondary}"
                                                       FontSize="10" FontWeight="Bold"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Margin="0,-1,0,0"/>
                                        </Border>
                                    </StackPanel>
                                    <Grid Name="GridOptiDefaultTabs" ColumnDefinitions="*,*,*">
                                        <Button Name="BtnOptiDefaultStable"
                                                Grid.Column="0"
                                                Content="Stable"
                                                Classes="BtnPrimary"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Center"
                                                FontSize="11"
                                                Padding="8,5"
                                                Margin="0,0,2,0"
                                                Click="BtnOptiDefaultStable_Click"/>
                                        <Button Name="BtnOptiDefaultBeta"
                                                Grid.Column="1"
                                                Content="Beta"
                                                Classes="BtnSecondary"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Center"
                                                FontSize="11"
                                                Padding="8,5"
                                                Margin="2,0,2,0"
                                                Click="BtnOptiDefaultBeta_Click"/>
                                        <Button Name="BtnOptiDefaultNightly"
                                                Grid.Column="2"
                                                Content="Nightly"
                                                Classes="BtnSecondary"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Center"
                                                FontSize="11"
                                                Padding="8,5"
                                                Margin="2,0,0,0"
                                                Click="BtnOptiDefaultNightly_Click"/>
                                        <Button Name="BtnOptiDefaultCustom"
                                                Grid.Column="3"
                                                Content="Custom"
                                                Classes="BtnSecondary"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Center"
                                                FontSize="11"
                                                Padding="8,5"
                                                Margin="2,0,0,0"
                                                IsVisible="False"
                                                Click="BtnOptiDefaultCustom_Click"/>
                                        <!-- Shown exclusively (Stable/Beta/Nightly/Custom hidden) while
                                             the Setup NR default mode = "Mod + OptiScaler" — the only
                                             "channel" available in that state, mirrors ManageGameWindow's
                                             own BtnOptiModded. -->
                                        <Button Name="BtnOptiDefaultModded"
                                                Grid.Column="0" Grid.ColumnSpan="4"
                                                Content="Modded"
                                                Classes="BtnPrimary"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Center"
                                                FontSize="11"
                                                Padding="8,5"
                                                IsVisible="False"
                                                IsHitTestVisible="False"/>
                                    </Grid>
                                    <ComboBox Name="CmbDefaultOptiScalerVersion"
                                              Classes="BtnSelector"
                                              HorizontalAlignment="Stretch"
                                              HorizontalContentAlignment="Left"
                                              VerticalContentAlignment="Center"
                                              SelectionChanged="CmbDefaultOptiScalerVersion_SelectionChanged"/>
                                </StackPanel>

                                <!-- Row 0, Col 1 : Extras / FSR4 DLL -->
                                <StackPanel Grid.Row="0" Grid.Column="1" Spacing="6">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="{DynamicResource TxtHelpFsr4DllDefaultLabel}"
                                                   FontWeight="SemiBold"
                                                   FontSize="14"
                                                   Foreground="{StaticResource BrTextPrimary}"
                                                   VerticalAlignment="Center"/>
                                        <Border Background="{StaticResource BrBgElevated}"
                                                BorderBrush="{StaticResource BrBorderSubtle}"
                                                BorderThickness="1" CornerRadius="8"
                                                Width="16" Height="16"
                                                ToolTip.ShowDelay="100" Cursor="Help"
                                                ToolTip.Tip="{DynamicResource TxtHelpFsr4DllDefaultText}">
                                            <TextBlock Text="?" Foreground="{StaticResource BrTextSecondary}"
                                                       FontSize="10" FontWeight="Bold"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Margin="0,-1,0,0"/>
                                        </Border>
                                    </StackPanel>
                                    <Grid Name="GridExtrasDefaultTabs" ColumnDefinitions="*,*">
                                        <Button Name="BtnExtrasDefaultInt8"
                                                Grid.Column="0"
                                                Content="INT8"
                                                Classes="BtnPrimary"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Center"
                                                FontSize="11"
                                                Padding="8,5"
                                                Margin="0,0,2,0"
                                                Click="BtnExtrasDefaultInt8_Click"/>
                                        <Button Name="BtnExtrasDefaultFp8"
                                                Grid.Column="1"
                                                Content="FP8"
                                                Classes="BtnSecondary"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Center"
                                                FontSize="11"
                                                Padding="8,5"
                                                Margin="2,0,0,0"
                                                Click="BtnExtrasDefaultFp8_Click"/>
                                    </Grid>
                                    <ComboBox Name="CmbDefaultExtrasVersion"
                                              Classes="BtnSelector"
                                              HorizontalAlignment="Stretch"
                                              HorizontalContentAlignment="Left"
                                              VerticalContentAlignment="Center"/>
                                </StackPanel>

                                <!-- Row 0, Col 2 : FSR 4 Swap Options -->
                                <StackPanel Grid.Row="0" Grid.Column="2" Spacing="6">
                                    <!-- Invisible spacer matching the height of the Stable/Beta/Nightly
                                         and INT8/FP8 tab rows in the neighboring columns, so this
                                         column's button lines up with their ComboBoxes below. Placed
                                         above the title (not between title and button) so the title
                                         sits right on top of its own control, same as the other columns. -->
                                    <Grid ColumnDefinitions="*,*" Opacity="0" IsHitTestVisible="False">
                                        <Button Grid.Column="0" Content="_" Classes="BtnPrimary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" FontSize="11" Padding="8,5" Margin="0,0,2,0"/>
                                        <Button Grid.Column="1" Content="_" Classes="BtnSecondary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" FontSize="11" Padding="8,5" Margin="2,0,0,0"/>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="{DynamicResource TxtFsr4SwapOptionsLbl}"
                                                   FontWeight="SemiBold"
                                                   FontSize="14"
                                                   Foreground="{StaticResource BrTextPrimary}"
                                                   VerticalAlignment="Center"/>
                                        <Border Background="{StaticResource BrBgElevated}"
                                                BorderBrush="{StaticResource BrBorderSubtle}"
                                                BorderThickness="1" CornerRadius="8"
                                                Width="16" Height="16"
                                                ToolTip.ShowDelay="100" Cursor="Help"
                                                ToolTip.Tip="{DynamicResource TxtFsr4SwapOptionsTooltip}">
                                            <TextBlock Text="?" Foreground="{StaticResource BrTextSecondary}"
                                                       FontSize="10" FontWeight="Bold"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Margin="0,-1,0,0"/>
                                        </Border>
                                    </StackPanel>
                                    <Button Name="BtnFsr4SwapOptions"
                                            Classes="BtnBase"
                                            MinHeight="40"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch"
                                            Padding="10,7"
                                            Click="BtnFsr4SwapOptions_Click">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Name="TxtFsr4SwapOptionsSelection"
                                                       Grid.Column="0"
                                                       Foreground="{StaticResource BrTextPrimary}"
                                                       TextTrimming="CharacterEllipsis"
                                                       HorizontalAlignment="Left"
                                                       VerticalAlignment="Center"/>
                                            <Canvas Grid.Column="1"
                                                    Width="16" Height="16"
                                                    VerticalAlignment="Center"
                                                    Margin="12,0,0,0">
                                                <Path Data="M2,6 L10,6 L10,14 L2,14 Z"
                                                      Stroke="{StaticResource BrTextSecondary}"
                                                      StrokeThickness="1.25"
                                                      Fill="Transparent"/>
                                                <Path Data="M6,3 L14,3 L14,11 L6,11 Z"
                                                      Stroke="{StaticResource BrTextSecondary}"
                                                      StrokeThickness="1.25"
                                                      Fill="{StaticResource BrBgElevated}"/>
                                            </Canvas>
                                        </Grid>
                                    </Button>
                                </StackPanel>

                                <!-- Row 1, Col 0 : Fakenvapi -->
                                <StackPanel Grid.Row="1" Grid.Column="0" Spacing="6">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="Fakenvapi"
                                                   FontWeight="SemiBold"
                                                   FontSize="14"
                                                   Foreground="{StaticResource BrTextPrimary}"
                                                   VerticalAlignment="Center"/>
                                        <Border Background="{StaticResource BrBgElevated}"
                                                BorderBrush="{StaticResource BrBorderSubtle}"
                                                BorderThickness="1" CornerRadius="8"
                                                Width="16" Height="16"
                                                ToolTip.ShowDelay="100" Cursor="Help"
                                                ToolTip.Tip="{DynamicResource TxtDefaultFakenvapiDesc}">
                                            <TextBlock Text="?" Foreground="{StaticResource BrTextSecondary}"
                                                       FontSize="10" FontWeight="Bold"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Margin="0,-1,0,0"/>
                                        </Border>
                                    </StackPanel>
                                    <ComboBox Name="CmbDefaultFakenvapiVersion"
                                              Classes="BtnSelector"
                                              HorizontalAlignment="Stretch"
                                              HorizontalContentAlignment="Left"
                                              VerticalContentAlignment="Center"
                                              Margin="0,4,0,0"/>
                                </StackPanel>

                                <!-- Row 1, Col 1 : Injection method -->
                                <StackPanel Grid.Row="1" Grid.Column="1" Spacing="6">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="{DynamicResource TxtInjectionLbl}"
                                                   FontWeight="SemiBold"
                                                   FontSize="14"
                                                   Foreground="{StaticResource BrTextPrimary}"
                                                   VerticalAlignment="Center"/>
                                        <Border Background="{StaticResource BrBgElevated}"
                                                BorderBrush="{StaticResource BrBorderSubtle}"
                                                BorderThickness="1" CornerRadius="8"
                                                Width="16" Height="16"
                                                ToolTip.ShowDelay="100" Cursor="Help"
                                                ToolTip.Tip="{DynamicResource TxtDefaultInjectionMethodDesc}">
                                            <TextBlock Text="?" Foreground="{StaticResource BrTextSecondary}"
                                                       FontSize="10" FontWeight="Bold"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Margin="0,-1,0,0"/>
                                        </Border>
                                    </StackPanel>
                                    <ComboBox Name="CmbDefaultInjectionMethod"
                                              Classes="BtnSelector"
                                              HorizontalAlignment="Stretch"
                                              VerticalContentAlignment="Center"
                                              Margin="0,4,0,0">
                                        <ComboBoxItem Content="Auto" Tag="auto" Classes="SentinelOption"/>
                                        <ComboBoxItem Content="dxgi.dll"     Tag="dxgi.dll"/>
                                        <ComboBoxItem Content="winmm.dll"    Tag="winmm.dll"/>
                                        <ComboBoxItem Content="d3d12.dll"    Tag="d3d12.dll"/>
                                        <ComboBoxItem Content="dbghelp.dll"  Tag="dbghelp.dll"/>
                                        <ComboBoxItem Content="version.dll"  Tag="version.dll"/>
                                        <ComboBoxItem Content="wininet.dll"  Tag="wininet.dll"/>
                                        <ComboBoxItem Content="winhttp.dll"  Tag="winhttp.dll"/>
                                    </ComboBox>
                                </StackPanel>

                                <!-- Row 1, Col 2 : OptiPatcher -->
                                <StackPanel Grid.Row="1" Grid.Column="2" Spacing="6">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="{DynamicResource TxtOptiPatcherLbl}"
                                                   FontWeight="SemiBold"
                                                   FontSize="14"
                                                   Foreground="{StaticResource BrTextPrimary}"
                                                   VerticalAlignment="Center"/>
                                        <Border Background="{StaticResource BrBgElevated}"
                                                BorderBrush="{StaticResource BrBorderSubtle}"
                                                BorderThickness="1" CornerRadius="8"
                                                Width="16" Height="16"
                                                ToolTip.ShowDelay="100" Cursor="Help"
                                                ToolTip.Tip="{DynamicResource TxtDefaultOptiPatcherTooltip}">
                                            <TextBlock Text="?" Foreground="{StaticResource BrTextSecondary}"
                                                       FontSize="10" FontWeight="Bold"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Margin="0,-1,0,0"/>
                                        </Border>
                                    </StackPanel>
                                    <ComboBox Name="CmbDefaultOptiPatcherVersion"
                                              Classes="BtnSelector"
                                              HorizontalAlignment="Stretch"
                                              HorizontalContentAlignment="Left"
                                              VerticalContentAlignment="Center"/>
                                </StackPanel>

                                <!-- Row 2, Col 0 : NukemFG -->
                                <StackPanel Grid.Row="2" Grid.Column="0" Spacing="6">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="NukemFG"
                                                   FontWeight="SemiBold"
                                                   FontSize="14"
                                                   Foreground="{StaticResource BrTextPrimary}"
                                                   VerticalAlignment="Center"/>
                                        <Border Background="{StaticResource BrBgElevated}"
                                                BorderBrush="{StaticResource BrBorderSubtle}"
                                                BorderThickness="1" CornerRadius="8"
                                                Width="16" Height="16"
                                                ToolTip.ShowDelay="100" Cursor="Help"
                                                ToolTip.Tip="{DynamicResource TxtDefaultNukemFGDesc}">
                                            <TextBlock Text="?" Foreground="{StaticResource BrTextSecondary}"
                                                       FontSize="10" FontWeight="Bold"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Margin="0,-1,0,0"/>
                                        </Border>
                                    </StackPanel>
                                    <ComboBox Name="CmbDefaultNukemFGVersion"
                                              Classes="BtnSelector"
                                              HorizontalAlignment="Stretch"
                                              HorizontalContentAlignment="Left"
                                              VerticalContentAlignment="Center"
                                              Margin="0,4,0,0"/>
                                </StackPanel>

                                <!-- Row 2, Col 1 : Profile -->
                                <StackPanel Grid.Row="2" Grid.Column="1" Spacing="6">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="{DynamicResource TxtProfileLbl}"
                                                   FontWeight="SemiBold"
                                                   FontSize="14"
                                                   Foreground="{StaticResource BrTextPrimary}"
                                                   VerticalAlignment="Center"/>
                                        <Border Background="{StaticResource BrBgElevated}"
                                                BorderBrush="{StaticResource BrBorderSubtle}"
                                                BorderThickness="1" CornerRadius="8"
                                                Width="16" Height="16"
                                                ToolTip.ShowDelay="100" Cursor="Help"
                                                ToolTip.Tip="{DynamicResource TxtProfileTooltip}">
                                            <TextBlock Text="?" Foreground="{StaticResource BrTextSecondary}"
                                                       FontSize="10" FontWeight="Bold"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Margin="0,-1,0,0"/>
                                        </Border>
                                    </StackPanel>
                                    <ComboBox Name="CmbDefaultProfile"
                                              Classes="BtnSelector"
                                              HorizontalAlignment="Stretch"
                                              HorizontalContentAlignment="Left"
                                              VerticalContentAlignment="Center"/>
                                </StackPanel>

                                <!-- Row 2, Col 2 : Frame Generation -->
                                <StackPanel Grid.Row="2" Grid.Column="2" Spacing="6">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="{DynamicResource TxtFrameGeneration}"
                                                   FontWeight="SemiBold"
                                                   FontSize="14"
                                                   Foreground="{StaticResource BrTextPrimary}"
                                                   VerticalAlignment="Center"/>
                                        <Border Background="{StaticResource BrBgElevated}"
                                                BorderBrush="{StaticResource BrBorderSubtle}"
                                                BorderThickness="1" CornerRadius="8"
                                                Width="16" Height="16"
                                                ToolTip.ShowDelay="100" Cursor="Help"
                                                ToolTip.Tip="{DynamicResource TxtDefaultFrameGenerationDesc}">
                                            <TextBlock Text="?" Foreground="{StaticResource BrTextSecondary}"
                                                       FontSize="10" FontWeight="Bold"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Margin="0,-1,0,0"/>
                                        </Border>
                                    </StackPanel>
                                    <Button Name="BtnDefaultFrameGeneration"
                                            Classes="BtnBase"
                                            MinHeight="40"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch"
                                            Padding="10,7"
                                            Click="BtnDefaultFrameGeneration_Click">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Name="TxtDefaultFrameGenerationSelection"
                                                       Grid.Column="0"
                                                       Foreground="{StaticResource BrTextPrimary}"
                                                       TextTrimming="CharacterEllipsis"
                                                       HorizontalAlignment="Left"
                                                       VerticalAlignment="Center"/>
                                            <Canvas Grid.Column="1"
                                                    Width="16" Height="16"
                                                    VerticalAlignment="Center"
                                                    Margin="12,0,0,0">
                                                <Path Data="M2,6 L10,6 L10,14 L2,14 Z"
                                                      Stroke="{StaticResource BrTextSecondary}"
                                                      StrokeThickness="1.25"
                                                      Fill="Transparent"/>
                                                <Path Data="M6,3 L14,3 L14,11 L6,11 Z"
                                                      Stroke="{StaticResource BrTextSecondary}"
                                                      StrokeThickness="1.25"
                                                      Fill="{StaticResource BrBgElevated}"/>
                                            </Canvas>
                                        </Grid>
                                    </Button>
                                </StackPanel>

                                <!-- Row 3, Col 0 : Upscaling Quality -->
                                <StackPanel Grid.Row="3" Grid.Column="0" Spacing="6">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="{DynamicResource TxtUpscalingQuality}"
                                                   FontWeight="SemiBold"
                                                   FontSize="14"
                                                   Foreground="{StaticResource BrTextPrimary}"
                                                   VerticalAlignment="Center"/>
                                        <Border Background="{StaticResource BrBgElevated}"
                                                BorderBrush="{StaticResource BrBorderSubtle}"
                                                BorderThickness="1" CornerRadius="8"
                                                Width="16" Height="16"
                                                ToolTip.ShowDelay="100" Cursor="Help"
                                                ToolTip.Tip="{DynamicResource TxtUpscalingQualityTooltip}">
                                            <TextBlock Text="?" Foreground="{StaticResource BrTextSecondary}"
                                                       FontSize="10" FontWeight="Bold"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Margin="0,-1,0,0"/>
                                        </Border>
                                    </StackPanel>
                                    <ComboBox Name="CmbDefaultUpscalingQuality"
                                              Classes="BtnSelector"
                                              HorizontalAlignment="Stretch"
                                              HorizontalContentAlignment="Left"
                                              VerticalContentAlignment="Center"
                                              MaxDropDownHeight="420"
                                              DropDownOpened="CmbDefaultUpscalingQuality_DropDownOpened"
                                              DropDownClosed="CmbDefaultUpscalingQuality_DropDownClosed"
                                              SelectionChanged="CmbDefaultUpscalingQuality_SelectionChanged"/>
                                </StackPanel>

                                <!-- Row 3, Col 1 : Output Upscaler -->
                                <StackPanel Grid.Row="3" Grid.Column="1" Spacing="6">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="{DynamicResource TxtOutputUpscaler}"
                                                   FontWeight="SemiBold"
                                                   FontSize="14"
                                                   Foreground="{StaticResource BrTextPrimary}"
                                                   VerticalAlignment="Center"/>
                                        <Border Background="{StaticResource BrBgElevated}"
                                                BorderBrush="{StaticResource BrBorderSubtle}"
                                                BorderThickness="1" CornerRadius="8"
                                                Width="16" Height="16"
                                                ToolTip.ShowDelay="100" Cursor="Help"
                                                ToolTip.Tip="{DynamicResource TxtOutputUpscalerTooltip}">
                                            <TextBlock Text="?" Foreground="{StaticResource BrTextSecondary}"
                                                       FontSize="10" FontWeight="Bold"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Margin="0,-1,0,0"/>
                                        </Border>
                                    </StackPanel>
                                    <ComboBox Name="CmbDefaultOutputUpscaler"
                                              Classes="BtnSelector"
                                              HorizontalAlignment="Stretch"
                                              HorizontalContentAlignment="Left"
                                              VerticalContentAlignment="Center"/>
                                </StackPanel>

                                <!-- Row 3, Col 2 : Spoofing (same Dxgi/StreamlineSpoofing/
                                     VulkanExtensionSpoofing override as ManageGameWindow's CmbSpoofing,
                                     pinned as the starting point for Quick Install). -->
                                <StackPanel Grid.Row="3" Grid.Column="2" Spacing="6">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="{DynamicResource TxtSpoofingLbl}"
                                                   FontWeight="SemiBold"
                                                   FontSize="14"
                                                   Foreground="{StaticResource BrTextPrimary}"
                                                   VerticalAlignment="Center"/>
                                        <Border Background="{StaticResource BrBgElevated}"
                                                BorderBrush="{StaticResource BrBorderSubtle}"
                                                BorderThickness="1" CornerRadius="8"
                                                Width="16" Height="16"
                                                ToolTip.ShowDelay="100" Cursor="Help"
                                                ToolTip.Tip="{DynamicResource TxtSpoofingTooltip}">
                                            <TextBlock Text="?" Foreground="{StaticResource BrTextSecondary}"
                                                       FontSize="10" FontWeight="Bold"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Margin="0,-1,0,0"/>
                                        </Border>
                                    </StackPanel>
                                    <ComboBox Name="CmbDefaultSpoofing"
                                              Classes="BtnSelector"
                                              HorizontalAlignment="Stretch"
                                              VerticalContentAlignment="Center"
                                              Margin="0,4,0,0">
                                        <ComboBoxItem Content="Auto" Tag="auto" Classes="SentinelOption"/>
                                        <ComboBoxItem Content="Enabled" Tag="true"/>
                                        <ComboBoxItem Content="Disabled" Tag="false"/>
                                    </ComboBox>
                                </StackPanel>

                                <!-- Row 4, all columns : Experimental zone (AMD DLSS Neural Rendering
                                     "Setup NR" defaults) — bordered strip so experimental controls read
                                     as visually distinct, mirroring ManageGameWindow's own
                                     BorderExperimentalZone/BorderExperimentalChip exactly. Hidden
                                     entirely unless Config.ShowExperimentalFeatures is on AND the
                                     configured default GPU is AMD (see
                                     ManageDefaultVersionsWindow.axaml.cs's
                                     PopulateDefaultDlssNrOnAmdModeCombo, which toggles both children
                                     below the same way PopulateVersionSelectors does there). -->
                                <Grid Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,4,0,0">
                                    <Border Name="BorderExperimentalZone"
                                            BorderBrush="{StaticResource BrExperimental}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource RadiusMedium}"
                                            Padding="12,16,12,12"
                                            IsVisible="False">
                                      <StackPanel Spacing="10">
                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                            <StackPanel Name="PanelDefaultDlssNrOnAmd" Grid.Column="0">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <TextBlock Text="{DynamicResource TxtDlssNrOnAmdTitle}"
                                                               Foreground="{StaticResource BrTextSecondary}"
                                                               FontSize="{StaticResource FontSizeCaption}"
                                                               VerticalAlignment="Center"/>
                                                    <Border Background="{StaticResource BrBgElevated}"
                                                            BorderBrush="{StaticResource BrBorderSubtle}"
                                                            BorderThickness="1" CornerRadius="8"
                                                            Width="16" Height="16"
                                                            ToolTip.ShowDelay="100" Cursor="Help"
                                                            ToolTip.Tip="{DynamicResource TxtDefaultDlssNrOnAmdDesc}">
                                                        <TextBlock Text="?" Foreground="{StaticResource BrTextSecondary}"
                                                                   FontSize="10" FontWeight="Bold"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                   Margin="0,-1,0,0"/>
                                                    </Border>
                                                </StackPanel>
                                                <ComboBox Name="CmbDefaultDlssNrOnAmdMode"
                                                          Margin="0,4,0,0"
                                                          HorizontalAlignment="Stretch"
                                                          Classes="BtnSelector"
                                                          Padding="8,0,24,0"
                                                          HorizontalContentAlignment="Left"
                                                          VerticalContentAlignment="Center"
                                                          SelectionChanged="CmbDefaultDlssNrOnAmdMode_SelectionChanged">
                                                    <ComboBoxItem Content="{DynamicResource TxtSetupNrModeNone}" Tag="none"/>
                                                    <ComboBoxItem Content="{DynamicResource TxtSetupNrModeDanielOnlyShort}" Tag="daniel-only"/>
                                                    <ComboBoxItem Content="{DynamicResource TxtSetupNrModeDanielAndOptiShort}" Tag="daniel-and-opti"/>
                                                </ComboBox>
                                            </StackPanel>

                                            <!-- Version of danielblnc's mod itself, pinned for Quick/Bulk
                                                 Install the same way ManageGameWindow's CmbDlssNrDanielVersion
                                                 pins it for a single game. Disabled while mode = none. -->
                                            <StackPanel Name="PanelDefaultDlssNrDanielVersion" Grid.Column="1">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <TextBlock Text="{DynamicResource TxtSetupNrDanielVersionLbl}"
                                                               Foreground="{StaticResource BrTextSecondary}"
                                                               FontSize="{StaticResource FontSizeCaption}"/>
                                                    <Border Background="{StaticResource BrBgElevated}"
                                                            BorderBrush="{StaticResource BrBorderSubtle}"
                                                            BorderThickness="1" CornerRadius="8"
                                                            Width="16" Height="16"
                                                            ToolTip.ShowDelay="100" Cursor="Help"
                                                            ToolTip.Tip="{DynamicResource TxtSetupNrDanielVersionTooltip}">
                                                        <TextBlock Text="?" Foreground="{StaticResource BrTextSecondary}"
                                                                   FontSize="10" FontWeight="Bold"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                   Margin="0,-1,0,0"/>
                                                    </Border>
                                                </StackPanel>
                                                <ComboBox Name="CmbDefaultDlssNrDanielVersion"
                                                          Margin="0,4,0,0"
                                                          HorizontalAlignment="Stretch"
                                                          Classes="BtnSelector"
                                                          Padding="8,0,24,0"
                                                          HorizontalContentAlignment="Left"
                                                          VerticalContentAlignment="Center"
                                                          IsEnabled="False"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Same fork disclosure as ManageGameWindow's
                                             PanelDlssNrLinuxWrapperWarning — visible only while
                                             "daniel-only" is selected on Linux (see
                                             ApplyDlssNrOnAmdModeSelection). -->
                                        <Border Name="PanelDefaultDlssNrLinuxWrapperWarning"
                                                Background="#2E2410"
                                                BorderBrush="{StaticResource BrWarning}"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="10,6"
                                                IsVisible="False">
                                            <Grid ColumnDefinitions="Auto,*">
                                                <TextBlock Grid.Column="0"
                                                           Text="&#xF4A4;"
                                                           FontFamily="{StaticResource FontIcons}"
                                                           Foreground="{StaticResource BrWarning}"
                                                           FontSize="16"
                                                           FontWeight="Bold"
                                                           VerticalAlignment="Top"
                                                           Margin="0,0,8,0"/>
                                                <TextBlock Grid.Column="1"
                                                           Text="{DynamicResource TxtSetupNrLinuxWrapperWarning}"
                                                           Foreground="{StaticResource BrWarning}"
                                                           FontSize="12"
                                                           FontWeight="Medium"
                                                           VerticalAlignment="Center"
                                                           TextWrapping="Wrap"/>
                                            </Grid>
                                        </Border>
                                      </StackPanel>
                                    </Border>
                                    <Border Name="BorderExperimentalChip"
                                            Background="{StaticResource BrBgDeep}"
                                            Padding="6,0"
                                            Margin="14,-7,0,0"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            IsVisible="False">
                                        <TextBlock Text="{DynamicResource TxtExperimentalZoneLbl}"
                                                   FontSize="10" FontWeight="Bold"
                                                   Foreground="{StaticResource BrExperimental}"/>
                                    </Border>
                                </Grid>

                                <!-- Row 5 : compatibility list info, spans all columns — always last. -->
                                <Border Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3"
                                        Background="{StaticResource BrBgElevated}"
                                        BorderBrush="{StaticResource BrBorderSubtle}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="10,8">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="&#xF4A4;"
                                                   FontFamily="{StaticResource FontIcons}"
                                                   Foreground="{StaticResource BrTextSecondary}"
                                                   FontSize="14"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="{DynamicResource TxtDefaultVersionsCompatInfo}"
                                                   Foreground="{StaticResource BrTextSecondary}"
                                                   FontSize="{StaticResource FontSizeCaption}"
                                                   VerticalAlignment="Center"
                                                   TextWrapping="Wrap"/>
                                        <Button Name="BtnViewCompatibilityList"
                                                Classes="InvisibleBtn"
                                                Cursor="Hand"
                                                VerticalAlignment="Center"
                                                Click="BtnViewCompatibilityList_Click">
                                            <TextBlock Text="{DynamicResource TxtCompatSidebarViewMore}"
                                                       Foreground="{StaticResource BrAccent}"
                                                       FontSize="{StaticResource FontSizeCaption}"
                                                       TextDecorations="Underline"/>
                                        </Button>
                                    </StackPanel>
                                </Border>

                            </Grid>
                        </ScrollViewer>

                        <!-- Footer Buttons -->
                        <Border Grid.Row="2"
                                Background="{StaticResource BrBgDeep}"
                                BorderBrush="{StaticResource BrBorderSubtle}"
                                BorderThickness="0,1,0,0"
                                Padding="24,16">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12">
                                <Button Content="{DynamicResource TxtCancel}"
                                        Classes="BtnSecondary"
                                        Padding="20,10"
                                        Click="BtnCancel_Click"/>
                                <Button Content="{DynamicResource TxtSave}"
                                        Classes="BtnPrimary"
                                        Padding="20,10"
                                        Click="BtnSave_Click"/>
                            </StackPanel>
                        </Border>

                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Panel>
</Window>
