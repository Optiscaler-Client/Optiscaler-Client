## A streamlined .gitignore for modern .NET projects
## including temporary files, build results, and
## files generated by popular .NET tools. If you are
## developing with Visual Studio, the VS .gitignore
## https://github.com/github/gitignore/blob/main/VisualStudio.gitignore
## has more thorough IDE-specific entries.
##
## Get latest from https://github.com/github/gitignore/blob/main/Dotnet.gitignore

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
[Dd]ist/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# .NET Core
project.lock.json
project.fragment.lock.json
artifacts/
.dotnet-home/

# ASP.NET Scaffolding
ScaffoldingReadMe.txt

# NuGet Packages
*.nupkg
# NuGet Symbol Packages
*.snupkg

# Others
~$*
*~
CodeCoverage/

# MSBuild Binary and Structured Log
*.binlog

# MSTest test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# NUnit
*.VisualState.xml
TestResult.xml
nunit-*.xml
# Application logs and local errors
error_log.txt
crash.log

# Runtime-generated update scripts
update.bat
update.sh

# User-specific project settings
*.csproj.user

# IDE specific files
.vs/
.idea/
.vscode/

# Claude Code
.claude/

# Publish output
publish/
dist/

# Git worktrees
.worktrees/

# ── fork-local (shyoo/Optiscaler-Client) ──────────────────────────────────
# Fork-only: never carry this block into an upstream PR. See AGENTS.md.

# Scratch notes and throwaway docs (plans worth keeping go in fork/)
transient_docs/
fork/scratch/
*.local.md

# Downloaded upstream mod binaries (dlssg_for_sm86 pinning, manual tests) —
# never commit mod or NVIDIA binaries; the client always downloads them.
fork/tools/.cache/
*.dlssg_tmp

# Local secrets for dev scripts (e.g. a GitHub token for the pin script)
.env
.env.*
*.pfx
# ── end fork-local ──────────────────────────────────────────────────────────
